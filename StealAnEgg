            end

            el.MultLabel.Text = string.format("%.2fx", info.scale)
            el.IncomeLabel.Text = info.formattedIncome

            -- Renderização 3D nativa do modelo do bicho no IconBg (AssetViewport)
            local mounted3D = attachPetViewport(el.IconBg, info.category)
            if mounted3D then
                el.PetImage.Visible = false
            else
                el.PetImage.Visible = true
                if info.icon ~= "" then el.PetImage.Image = info.icon end
            end

            el.Card.Visible = true
        elseif el then
            el.Card.Visible = false
            el.IconBg:SetAttribute("RenderedCategory", nil)
            for _, child in ipairs(el.IconBg:GetChildren()) do
                if child:IsA("ViewportFrame") or child.Name == "PreviewViewport" then
                    pcall(function() child:Destroy() end)
                end
            end
        end
    end

    refreshSelection()
end

