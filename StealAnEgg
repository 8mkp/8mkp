                        "🐺 **Egg:** %s\n%s **Location:** %s\n🔺 **Spawned:** <t:%d:R>\n💵 **Money:** %s\n📏 **Tamanho:** %s\n🎮 **Join Game:** [Click Here](https://www.roblox.com/games/116678181432234)",
                        englishName,
                        locEmoji,
                        locName,
                        os.time(),
                        moneyStr,
                        sizeStr
                    )

                    -- Cor lateral da barra
                    local finalColor = embedColor
                    if isEternal then finalColor = 11488255 -- Roxo vibrante (#AF4BFF)
                    elseif isDivine then finalColor = 16096779 -- Dourado (#F59E0B)
                    elseif isSecret then finalColor = 15680580 -- Vermelho (#EF4444)
                    end

                    local hasValidImage = (type(publicImage) == "string" and publicImage:find("^https?://") ~= nil and not publicImage:find("420/420/Image/Png"))

                    sendHttp({
                        content = string.format("<@&%s> **%s** %s spawned in %s!", ROLE_ID, rarityName, englishName, locName),
                        embeds = {{
                            title = titleStr,
                            color = finalColor,
                            description = descContent,
                            thumbnail = hasValidImage and { url = publicImage } or nil,
                            footer = {
                                text = "Sappire Hub • Steal An Egg Notifier",
                                icon_url = "https://tr.rbxcdn.com/180DAY-6b0a0f92f70c7748c90fb3d90dc56234/150/150/GameIcon7/Png/noFilter"
                            },
                            timestamp = DateTime.now():ToIsoDate()
                        }}
                    })
                end)
            end
        end
    end

    -- Se surgiram ovos de alta raridade (Divine, Eternal, Secret), notifica na tela estritamente o de MAIOR geração
    if #newHighTierEggs > 0 then
        table.sort(newHighTierEggs, function(a, b)
            return (a.income or 0) > (b.income or 0)
        end)
        showTargetNotification(newHighTierEggs[1])
    end

    -- Ordenação idêntica ao Lennon Hub: estritamente o de maior Geração ($/s)
    table.sort(ranked, function(a, b)
        return (a.income or 0) > (b.income or 0)
    end)

    currentTopData = ranked

    for i = 1, 5 do
        local el = cardElements[i]
        local info = ranked[i]
        if info and el then
            el.NameLabel.Text = info.name
            el.RarityLabel.Text = (info.mutation ~= "Normal") and string.format("%s (%s)", info.rarity, info.mutation) or info.rarity
            el.RarityLabel.TextColor3 = rarityColors[info.rarity] or Color3.fromRGB(168, 85, 247)

            -- Borda de destaque para raridade Secret (e raridades muito escuras) para não sumir no fundo preto
            if el.RarityStroke then
                if info.rarity == "Secret" then
                    el.RarityStroke.Transparency = 0
                    el.RarityStroke.Color = Color3.fromRGB(255, 255, 255) -- Borda branca nítida em volta do nome Secret
