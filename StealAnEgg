local function getMyPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil, nil, nil end

    local userId = o.UserId
    local userName = o.Name
    local found = nil

    if v then
        local ok, res = pcall(function() return v:InvokeServer() end)
        if ok and type(res) == "table" and type(res.OwnersBySlot) == "table" then
            for slot, owner in pairs(res.OwnersBySlot) do
                if owner == userId or tostring(owner) == tostring(userId) or owner == userName then
                    found = plots:FindFirstChild(tostring(slot))
                    if found then break end
                end
            end
        end
    end

    if not found then
        for _, p2 in ipairs(plots:GetChildren()) do
            local ownerAttr = p2:GetAttribute("Owner") or p2:GetAttribute("OwnerUserId") or p2:GetAttribute("UserId")
            if ownerAttr and (ownerAttr == userId or tostring(ownerAttr) == tostring(userId) or ownerAttr == userName) then
                found = p2 break
            end
            for _, name in ipairs({"Owner", "OwnerUserId", "UserId"}) do
                local obj = p2:FindFirstChild(name)
                if obj and (obj.Value == userId or tostring(obj.Value) == tostring(userId) or obj.Value == userName) then
                    found = p2 break
                end
            end
            if found then break end
        end
    end

    if not found then found = plots:FindFirstChild("1") or plots:FindFirstChild("2") or plots:GetChildren()[1] end
    if not found then return nil, nil, nil end

    local toUpdate = found:FindFirstChild("ToUpdate")
    local pen = (toUpdate and toUpdate:FindFirstChild("PetArea")) or found:FindFirstChild("PetArea")
    local origin = found:FindFirstChild("CenterPoint") or pen or found.PrimaryPart
    local tread = found:FindFirstChild("TreadmillBottom", true)

    return found, pen, origin, tread
end

local function getFreePetAreaPosition(pen, usedPositions)
    if not pen then return nil end
    local size = pen.Size
    local halfX = math.max(4, size.X / 2 - 5)
    local halfZ = math.max(4, size.Z / 2 - 5)

    for _ = 1, 30 do
        local x = math.random(-math.floor(halfX), math.floor(halfX))
        local z = math.random(-math.floor(halfZ), math.floor(halfZ))
        local cf = pen.CFrame * CFrame.new(x, size.Y / 2 + 1, z)
        local free = true
        for _, existing in ipairs(usedPositions) do
            if (existing - cf.Position).Magnitude < 5 then
                free = false
                break
            end
        end
        if free then return cf end
    end
    return pen.CFrame * CFrame.new(0, size.Y / 2 + 1, 0)
end

