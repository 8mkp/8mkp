-- Gerador de posições na grade do cercado oficial (Chilli Hub fn45: X=-24..8 passo 4, Z=4..30 passo 4, Y=-0.5)
local function generateChilliGridPositions(existingPositions)
    local candidates = {}
    for x = -24, 8, 4 do
        for z = 4, 30, 4 do
            local cand2D = Vector2.new(x, z)
            local isFree = true
            for _, placedPos in ipairs(existingPositions) do
                if (placedPos - cand2D).Magnitude < 5 then
                    isFree = false
                    break
                end
            end
            if isFree then
                table.insert(candidates, CFrame.new(x, -0.5, z))
            end
        end
    end

    -- Embaralhamento aleatório (Fisher-Yates) idêntico ao Chilli
    local rng = Random.new()
    for i = #candidates, 2, -1 do
        local j = rng:NextInteger(1, i)
        candidates[i], candidates[j] = candidates[j], candidates[i]
    end
    return candidates
end

-- Determina a capacidade disponível do cercado (Chilli Hub fn43)
local function getChilliPenCapacity(ownerEggs)
    local placedCount = 0
    if type(ownerEggs) == "table" then
        for _, v in pairs(ownerEggs) do
            if type(v) == "table" and v.Placement ~= nil then
                placedCount = placedCount + 1
            end
        end
    end

    local maxCap = 30
    pcall(function()
        if ChilliSys.rfWearLimit and ChilliSys.rfWearLimit:IsA("RemoteFunction") then
            local okLim, resLim = pcall(ChilliSys.rfWearLimit.InvokeServer, ChilliSys.rfWearLimit)
            if okLim and tonumber(resLim) then
                maxCap = tonumber(resLim)
            end
        end
    end)

    local freeSlots = math.max(0, maxCap - placedCount)
    return freeSlots, maxCap, placedCount
end

-- Resolve a localização do cercado oficial do jogador (Chilli Hub PenAnchor)
local function getChilliPenAnchor()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil end

    local myPlot = nil
    local myName = string.lower(player.Name)
    local myDisplay = string.lower(player.DisplayName)

    for _, child in ipairs(plots:GetChildren()) do
        local plotSign = child:FindFirstChild("PlotSign")
        local pps = plotSign and plotSign:FindFirstChild("PlayerPlotSign")
        local frame = pps and pps:FindFirstChild("Frame")
        local plText = frame and frame:FindFirstChild("PlayerName")
        if plText and plText:IsA("TextLabel") then
            local t = string.lower(plText.Text)
            if t == myName or t == myDisplay then
                myPlot = child
                break
            end
        end
    end

    if not myPlot then
        local found = getMyPlot()
        if found then myPlot = found end
    end

    if not myPlot then return nil end

    local toUpdate = myPlot:FindFirstChild("ToUpdate")
    local starterPen = (toUpdate and toUpdate:FindFirstChild("StarterPen")) 
        or myPlot:FindFirstChild("StarterPen") 
        or myPlot:FindFirstChild("CenterPoint")

    if not starterPen then return nil end

    local ok, res = pcall(function()
        return starterPen:IsA("Model") and starterPen:GetPivot() or starterPen.CFrame
    end)
    return ok and res and res.Position or nil
end

-- Voo suave até o cercado igual ao Chilli Hub (necessário para o servidor aceitar AskPlaceEgg)
local function flyToPen(targetPos)
    local char = player.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    if (hrp.Position - targetPos).Magnitude <= 25 then
        return true
    end

    local startPos = hrp.Position
    local highY = math.max(startPos.Y, targetPos.Y) + 28
    local highStart = Vector3.new(startPos.X, highY, startPos.Z)
    local highTarget = Vector3.new(targetPos.X, highY, targetPos.Z)
    local finalPos = targetPos + Vector3.new(0, 3, 0)

    local waypoints = { highStart, highTarget, finalPos }
    for _, wp in ipairs(waypoints) do
        local maxTime = 1.8
        local elapsed = 0
        while (hrp.Position - wp).Magnitude > 3 and elapsed < maxTime and not isDestroyed do
            local dt = RunService.Heartbeat:Wait()
            elapsed = elapsed + dt
            local dir = wp - hrp.Position
            local step = math.min(dir.Magnitude, 400 * dt)
            hrp.CFrame = CFrame.new(hrp.Position + dir.Unit * step)
            hrp.AssemblyLinearVelocity = Vector3.zero
            hrp.AssemblyAngularVelocity = Vector3.zero
        end
        hrp.CFrame = CFrame.new(wp)
        hrp.AssemblyLinearVelocity = Vector3.zero
    end
    return (hrp.Position - targetPos).Magnitude <= 26
end

executePlaceEggs = function()
    local rfPlace = (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking") and ReplicatedStorage.Packages.Networking:FindFirstChild("RF/EggWorld/AskPlaceEgg"))
        or K
    if ChilliSys.isCurrentlyPlacing or not rfPlace then return 0 end
    ChilliSys.isCurrentlyPlacing = true

    local ownerEggs = nil
    if EggState and type(EggState.ReadOwnerEggs) == "function" then
        local ok, res = pcall(EggState.ReadOwnerEggs, o.UserId)
        if ok and type(res) == "table" then ownerEggs = res end
    end

    -- Fallback se EggState não responder: usa c (AskLiveSnapshot)
    if not ownerEggs and c then
        local ok, res = pcall(function() return c:InvokeServer() end)
        if ok and type(res) == "table" then
            for _, rec in pairs(res) do
                if type(rec) == "table" and rec.OwnerUserId == o.UserId and rec.Records then
                    ownerEggs = rec.Records
                    break
                end
            end
        end
    end

    if not ownerEggs then
        ChilliSys.isCurrentlyPlacing = false
        return 0
    end

    local freeSlots, maxCap, placedCount = getChilliPenCapacity(ownerEggs)
    if freeSlots <= 0 then
        ChilliSys.isCurrentlyPlacing = false
        return 0
    end

    -- Coleta posições já ocupadas no cercado
    local existingPositions = {}
    local unplacedEggs = {}
    local now = os.clock()

    for k, v in pairs(ownerEggs) do
        if type(v) == "table" then
            if v.Placement ~= nil then
                local lcf = v.Placement.LocalCFrame
                if typeof(lcf) == "CFrame" then
                    table.insert(existingPositions, Vector2.new(lcf.Position.X, lcf.Position.Z))
                end
            else
                local uid = tostring(k)
                if not ChilliSys.placeCooldowns[uid] or ChilliSys.placeCooldowns[uid] <= now then
                    table.insert(unplacedEggs, {
                        Uid = uid,
                        Scale = tonumber(v.AssetScale) or 0
                    })
                end
            end
        end
    end

    if #unplacedEggs == 0 then
        ChilliSys.isCurrentlyPlacing = false
        return 0
    end

    -- Validação crucial do Chilli: o jogador DEVE estar a até 26 studs do cercado
    local penPos = getChilliPenAnchor()
    if penPos then
        local char = player.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp and (hrp.Position - penPos).Magnitude > 25 then
            local arrived = flyToPen(penPos)
            if not arrived and (hrp.Position - penPos).Magnitude > 30 then
                ChilliSys.isCurrentlyPlacing = false
                return 0
            end
        end
    end

    -- Ordena ovos: maiores primeiro (Chilli sort padrão)
    table.sort(unplacedEggs, function(a, b)
        return (a.Scale or 0) > (b.Scale or 0)
    end)

    local placedTotal = 0

    for _, eggData in ipairs(unplacedEggs) do
        if placedTotal >= freeSlots or not autoPlaceEggEnabled or isDestroyed then break end

        local eggUid = tostring(eggData.Uid)
        local candidateCFrames = generateChilliGridPositions(existingPositions)
        if #candidateCFrames == 0 then break end

        -- Equipa o ovo (Chilli: WearEggTool)
        pcall(function()
            if EggState and type(EggState.WearEggTool) == "function" then
                EggState.WearEggTool(eggUid)
            elseif ChilliSys.rfWearTool and ChilliSys.rfWearTool:IsA("RemoteFunction") then
                ChilliSys.rfWearTool:InvokeServer(eggUid)
            end
        end)

        -- Garante que o item esteja na mão (Character) se foi para a Backpack
        local char = player.Character
        local bp = player:FindFirstChild("Backpack")
        if bp and char then
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") and (t:GetAttribute("UID") == eggUid or t.Name == eggUid) then
                    t.Parent = char
                    break
                end
            end
        end

        task.wait(0.2)

        -- Tenta posicionar nas coordenadas livres geradas (até 8 tentativas)
        local placed = false
        local tries = 0
        for _, cframe in ipairs(candidateCFrames) do
            tries = tries + 1
            if tries > 8 then break end

            local okPlace, placeRes = pcall(function()
                return rfPlace:InvokeServer({ Uid = eggUid, LocalCFrame = cframe })
            end)

            if okPlace and placeRes ~= false then
                table.insert(existingPositions, Vector2.new(cframe.Position.X, cframe.Position.Z))
                placedTotal = placedTotal + 1
                placed = true
                ChilliSys.placeCooldowns[eggUid] = nil
                break
            end
            task.wait(0.04)
        end

        if not placed then
            ChilliSys.placeCooldowns[eggUid] = os.clock() + 15 -- 15s de cooldown se falhar
        end

        task.wait(0.1)
    end

    -- Desequipa o ovo após posicionar (Chilli: DoffEggTool)
    pcall(function()
        if EggState and type(EggState.DoffEggTool) == "function" then
            EggState.DoffEggTool()
        elseif ChilliSys.rfDoffEggTool and ChilliSys.rfDoffEggTool:IsA("RemoteFunction") then
            ChilliSys.rfDoffEggTool:InvokeServer()
        end
    end)

    ChilliSys.isCurrentlyPlacing = false
    return placedTotal
end


executeAutoHatch = function()
    if ChilliSys.isCurrentlyHatching then return 0 end
    local rfHatch = g or resolveRemote("RF/EggWorld/AskHatch", "AskHatch")
    local rfFinish = Q or resolveRemote("RF/EggWorld/AskFinishHatch", "AskFinishHatch")
    if not rfHatch or not rfFinish then return 0 end

    local ownerEggs = nil
    if EggState and type(EggState.ReadOwnerEggs) == "function" then
        local ok, res = pcall(EggState.ReadOwnerEggs, o.UserId)
        if ok and type(res) == "table" and next(res) ~= nil then ownerEggs = res end
    end

    if not ownerEggs and c then
        local ok, res = pcall(function() return c:InvokeServer() end)
        if ok and type(res) == "table" then
            for _, rec in pairs(res) do
                if type(rec) == "table" and rec.OwnerUserId == o.UserId and rec.Records then
                    ownerEggs = rec.Records
                    break
                end
            end
        end
    end

    if not ownerEggs then return 0 end

    local readyQueue = {}
    local now = os.clock()
    local serverTimeNow = Workspace:GetServerTimeNow()

    for k, v in pairs(ownerEggs) do
        if type(v) == "table" and v.Placement ~= nil then
            if (ChilliSys.hatchCooldowns[k] or 0) <= now then
                local isReady = false

                -- 1. Método primário do Chilli Hub: EggState.IsReadyToHatch
                if EggState and type(EggState.IsReadyToHatch) == "function" then
                    local okReady, resReady = pcall(EggState.IsReadyToHatch, k)
                    if okReady and resReady == true then
                        isReady = true
                    else
                        local okReadyStr, resReadyStr = pcall(EggState.IsReadyToHatch, tostring(k))
                        if okReadyStr and resReadyStr == true then
                            isReady = true
                        end
                    end
                end

                -- 2. Fallback oficial do Chilli Hub (fn36): EggRecords.GrowthSecondsRemaining
                if not isReady and EggRecords and type(EggRecords.GrowthSecondsRemaining) == "function" then
                    local growthMult = 1
                    if type(EggRecords.GrowthSpeedMultiplier) == "function" then
                        local okM, resM = pcall(EggRecords.GrowthSpeedMultiplier, v)
                        if okM and type(resM) == "number" then growthMult = resM end
                    end
                    local okRem, remSec = pcall(EggRecords.GrowthSecondsRemaining, v, serverTimeNow, growthMult)
                    if okRem and type(remSec) == "number" and remSec <= 0 then
                        isReady = true
                    end
                end

                -- 3. Fallback por timestamp se tudo falhar
                if not isReady and v.Placement then
                    local placedAt = v.Placement.PlacedAt or v.Placement.Time or 0
                    if placedAt > 0 and (serverTimeNow - placedAt) >= 300 then
                        isReady = true
                    end
                end

                if isReady then table.insert(readyQueue, k) end
            end
        end
    end

    if #readyQueue == 0 then return 0 end

    ChilliSys.isCurrentlyHatching = true
    local hatchedTotal = 0

    for _, eggUid in ipairs(readyQueue) do
        if not autoHatchEnabled or isDestroyed then break end

        -- 1. Inicia o choco (RF/EggWorld/AskHatch) - idêntico ao Chilli Hub fn40
        local okHatch, hatchRes = pcall(function()
            if rfHatch:IsA("RemoteFunction") then
                return rfHatch:InvokeServer(eggUid)
            else
                return rfHatch:FireServer(eggUid)
            end
        end)

        if okHatch and hatchRes ~= false then
            -- Delay oficial do Chilli Hub (0.35s)
            task.wait(0.35)

            -- 2. Finaliza o choco (RF/EggWorld/AskFinishHatch)
            pcall(function()
                if rfFinish:IsA("RemoteFunction") then
                    rfFinish:InvokeServer(eggUid)
                else
                    rfFinish:FireServer(eggUid)
                end
            end)

            hatchedTotal = hatchedTotal + 1
            ChilliSys.hatchCooldowns[eggUid] = nil
        else
            ChilliSys.hatchCooldowns[eggUid] = os.clock() + 10 -- 10s de cooldown se o servidor recusar
        end

        task.wait(0.2)
    end

    ChilliSys.isCurrentlyHatching = false
    return hatchedTotal
end
end



local function executeMountTreadmill()
    local char = o.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
