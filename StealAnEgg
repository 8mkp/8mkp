    end

    -- Carregando ovo errado! Solta imediatamente (Chilli Hub tbl4.Steal.WrongEgg)
    print("[Sappire Hub] [WrongEgg] Ovo errado detectado em maos (" .. tostring(SafeCarry.CarryUid) .. " ~= " .. tostring(targetUid) .. ")! Soltando imediatamente...")
    if EggState and type(EggState.DropFieldEgg) == "function" then
        pcall(EggState.DropFieldEgg, "PlayerRequest")
    end

