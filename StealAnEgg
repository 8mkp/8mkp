    switchTrack.BackgroundColor3 = defaultState and Color3.fromRGB(175, 75, 255) or Color3.fromRGB(35, 35, 42)
    switchTrack.BorderSizePixel = 0

    local trackCorner = Instance.new("UICorner", switchTrack)
    trackCorner.CornerRadius = UDim.new(1, 0)

    local knob = Instance.new("Frame", switchTrack)
    knob.Size = UDim2.new(0, 14, 0, 14)
    knob.Position = defaultState and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
    knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    knob.BorderSizePixel = 0

    local knobCorner = Instance.new("UICorner", knob)
    knobCorner.CornerRadius = UDim.new(1, 0)

    local isToggled = defaultState or false

    local function updateVisual(animate)
        local targetKnobPos = isToggled and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7)
        local targetTrackColor = isToggled and Color3.fromRGB(175, 75, 255) or Color3.fromRGB(35, 35, 42)
        if animate then
            TweenService:Create(knob, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = targetKnobPos }):Play()
            TweenService:Create(switchTrack, TweenInfo.new(0.2, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { BackgroundColor3 = targetTrackColor }):Play()
        else
            knob.Position = targetKnobPos
            switchTrack.BackgroundColor3 = targetTrackColor
        end
    end

    local function toggleAction()
        isToggled = not isToggled
        updateVisual(true)
        if callback then callback(isToggled) end
    end

    toggleBtn.MouseButton1Click:Connect(toggleAction)
    toggleCallbacks[toggleName] = { Toggle = toggleAction, GetState = function() return isToggled end }
end

