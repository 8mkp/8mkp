function SafeCarry.WrongEgg(targetUid)
    if type(targetUid) ~= "string" or not SafeCarry.IsCarrying then
        return false
    end
    -- Se estiver carregando o ovo correto, nao e ovo errado
    if SafeCarry.CarryUid == targetUid then
