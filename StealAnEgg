local function getObjectPosition(obj)
    if not obj then return nil end
    if obj:IsA("BasePart") then return obj.Position end
    if obj:IsA("Model") then
        if obj.PrimaryPart then return obj.PrimaryPart.Position end
        local hitPart = obj:FindFirstChildWhichIsA("BasePart", true)
        if hitPart then return hitPart.Position end
    end
    return nil
end

local function resolveEggInstance(eggInfo)
    if not eggInfo then return nil end
    if eggInfo.instance and eggInfo.instance:IsA("PVInstance") and eggInfo.instance.Parent and eggInfo.instance:IsDescendantOf(Workspace) then
        return eggInfo.instance
    end

    local uid = tostring(eggInfo.uid or "")
    local slot = tostring(eggInfo.slotKey or "")

    local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slots then
        if uid ~= "" then
            local found = slots:FindFirstChild(uid, true)
            if found and found:IsA("PVInstance") then return found end
            for _, child in ipairs(slots:GetChildren()) do
                if child.Name == uid or child:GetAttribute("UID") == uid or child:GetAttribute("Uid") == uid or child:GetAttribute("EggUid") == uid then
                    return child
                end
            end
        end
        if slot ~= "" then
            local found = slots:FindFirstChild(slot, true)
            if found and found:IsA("PVInstance") then return found end
        end
    end

    local possibleContainers = {
        Workspace:FindFirstChild("Eggs"),
        Workspace:FindFirstChild("FieldEggs"),
        Workspace:FindFirstChild("SpawnedEggs"),
        Workspace:FindFirstChild("Plots"),
        Workspace:FindFirstChild("Map"),
        Workspace:FindFirstChild("Debris")
    }

    for _, container in ipairs(possibleContainers) do
        if container then
            local found = container:FindFirstChild(uid, true) or container:FindFirstChild(slot, true)
            if found and found:IsA("PVInstance") and found:IsDescendantOf(Workspace) then return found end
        end
    end

    if uid ~= "" then
        local found = Workspace:FindFirstChild(uid, true)
        if found and found:IsA("PVInstance") and found:IsDescendantOf(Workspace) then return found end
    end

    -- Busca por proximidade física direta no AreaEggSlotsClient (dentro de 12 studs)
    local targetPos = (eggInfo.CFrame and eggInfo.CFrame.Position) or (eggInfo.BoundsCFrame and eggInfo.BoundsCFrame.Position) or eggInfo.Position
    if targetPos and slots then
        for _, child in ipairs(slots:GetChildren()) do
            local part = child:FindFirstChildWhichIsA("BasePart") or child.PrimaryPart
            if part and (part.Position - targetPos).Magnitude <= 12 then
                return child
            end
        end
    end

    return nil
end

local function resolveTargetCFrame(eggInfo)
    if not eggInfo then return nil end
    if eggInfo.CFrame and eggInfo.CFrame ~= CFrame.new() then return eggInfo.CFrame end
    if eggInfo.BoundsCFrame then return eggInfo.BoundsCFrame end
    if eggInfo.Position then return CFrame.new(eggInfo.Position) end

    local inst = resolveEggInstance(eggInfo)
    if inst then
        if inst:IsA("Model") then return inst:GetPivot() end
        if inst:IsA("BasePart") then return inst.CFrame end
    end

    local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slots and eggInfo.uid then
        local found = slots:FindFirstChild(tostring(eggInfo.uid), true)
        if found then return found:GetPivot() end
    end
    return nil
end

