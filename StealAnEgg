        end
    end

    if humanoid and humanoid.FloorMaterial ~= Enum.Material.Air and math.abs(root.AssemblyLinearVelocity.Y) < 10 then
        lastSafePosition = root.CFrame
    end

    if antiBastaoEnabled and lastSafePosition and not isAutoStealActive and not isCombatFlyingActive then
        if root.AssemblyLinearVelocity.Y > 30 then
