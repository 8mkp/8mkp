local function isEggTool(tool)
    if not tool or not tool:IsA("Tool") then return false end
    local lname = string.lower(tool.Name)
    if string.find(lname, "sword") or string.find(lname, "radar") or string.find(lname, "punch") then return false end
    if tool:GetAttribute("EggUid") or tool:GetAttribute("UID") or string.find(lname, "egg") or tool:GetAttribute("Category") then return true end
    return false
end

local function getMyPlot()
    local plots = Workspace:FindFirstChild("Plots")
    if not plots then return nil, nil, nil end

    local userId = o.UserId
    local userName = o.Name
    local found = nil

    if v then
        local ok, res = pcall(function() return v:InvokeServer() end)
        if ok and type(res) == "table" and type(res.OwnersBySlot) == "table" then
            for slot, owner in pairs(res.OwnersBySlot) do
                if owner == userId or tostring(owner) == tostring(userId) or owner == userName then
                    found = plots:FindFirstChild(tostring(slot))
                    if found then break end
                end
            end
        end
    end

    if not found then
        for _, p2 in ipairs(plots:GetChildren()) do
            local ownerAttr = p2:GetAttribute("Owner") or p2:GetAttribute("OwnerUserId") or p2:GetAttribute("UserId")
            if ownerAttr and (ownerAttr == userId or tostring(ownerAttr) == tostring(userId) or ownerAttr == userName) then
                found = p2 break
            end
            for _, name in ipairs({"Owner", "OwnerUserId", "UserId"}) do
                local obj = p2:FindFirstChild(name)
                if obj and (obj.Value == userId or tostring(obj.Value) == tostring(userId) or obj.Value == userName) then
                    found = p2 break
                end
            end
            if found then break end
        end
    end

    if not found then found = plots:FindFirstChild("1") or plots:FindFirstChild("2") or plots:GetChildren()[1] end
    if not found then return nil, nil, nil end

    local toUpdate = found:FindFirstChild("ToUpdate")
    local pen = (toUpdate and toUpdate:FindFirstChild("PetArea")) or found:FindFirstChild("PetArea")
    local origin = found:FindFirstChild("CenterPoint") or pen or found.PrimaryPart
    local tread = found:FindFirstChild("TreadmillBottom", true)

    return found, pen, origin, tread
end

local function getFreePetAreaPosition(pen, usedPositions)
    if not pen then return nil end
    local size = pen.Size
    local halfX = math.max(4, size.X / 2 - 5)
    local halfZ = math.max(4, size.Z / 2 - 5)

    for _ = 1, 30 do
        local x = math.random(-math.floor(halfX), math.floor(halfX))
        local z = math.random(-math.floor(halfZ), math.floor(halfZ))
        local cf = pen.CFrame * CFrame.new(x, size.Y / 2 + 1, z)
        local free = true
        for _, existing in ipairs(usedPositions) do
            if (existing - cf.Position).Magnitude < 5 then
                free = false
                break
            end
        end
        if free then return cf end
    end
    return pen.CFrame * CFrame.new(0, size.Y / 2 + 1, 0)
end

local function executePlaceEggs()
    if not K then return 0 end
    local plot, pen, origin = getMyPlot()
    if not origin or not pen then return 0 end

    local placed = 0
    local usedPositions = {}

    if c then
        local ok, res = pcall(function() return c:InvokeServer() end)
        if ok and type(res) == "table" then
            for _, rec in pairs(res) do
                if type(rec) == "table" and rec.OwnerUserId == o.UserId and rec.Records then
                    for _, egg in pairs(rec.Records) do
                        if egg.Placement and egg.Placement.LocalCFrame then
                            table.insert(usedPositions, (origin.CFrame * egg.Placement.LocalCFrame).Position)
                        end
                    end
                end
            end
        end
    end

    local inventory = {}
    local char = o.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if isEggTool(child) then table.insert(inventory, child) end
        end
    end
    local bp = o:FindFirstChild("Backpack")
    if bp then
        for _, child in ipairs(bp:GetChildren()) do
            if isEggTool(child) then table.insert(inventory, child) end
        end
    end

    for _, tool in ipairs(inventory) do
        local uid = tool:GetAttribute("UID") or tool:GetAttribute("EggUid") or tool.Name
        local cf = getFreePetAreaPosition(pen, usedPositions)
        if cf then
            local localCf = origin.CFrame:ToObjectSpace(cf)
            local ok, res = pcall(function()
                return K:InvokeServer({ Uid = uid, LocalCFrame = localCf })
            end)
            if ok and res ~= false then
                placed = placed + 1
                table.insert(usedPositions, cf.Position)
            end
            task.wait(0.06)
        end
    end
    return placed
end

local isCurrentlyHatching = false
local function executeAutoHatch()
    if isCurrentlyHatching or not g or not Q or not c then return 0 end
    isCurrentlyHatching = true

    local ok, res = pcall(function() return c:InvokeServer() end)
    if not ok or type(res) ~= "table" then
        isCurrentlyHatching = false
        return 0
    end

    local myEggs = {}
    for _, rec in pairs(res) do
        if type(rec) == "table" and rec.OwnerUserId == o.UserId and rec.Records then
            for k2, v2 in pairs(rec.Records) do myEggs[k2] = v2 end
        end
    end

    local ready = {}
    local serverTime = Workspace:GetServerTimeNow()

    for uid, egg in pairs(myEggs) do
        if egg.Placement then
            local isReady = nil
            if EggState then
                local checkFn = EggState.IsReadyToHatch or EggState.IsLocalEggReady
                if checkFn then
                    local ok2, res2 = pcall(checkFn, uid)
                    if ok2 and type(res2) == "boolean" then isReady = res2 end
                end
            end
            if isReady == nil then
                local placedAt = egg.Placement.PlacedAt or egg.Placement.Time or 0
                isReady = (serverTime - placedAt) >= 30
            end
            if isReady then table.insert(ready, uid) end
        end
    end

    for _, uid in ipairs(ready) do
        task.spawn(function()
            local ok2 = pcall(function()
                if g:IsA("RemoteFunction") then g:InvokeServer(uid) else g:FireServer(uid) end
            end)
            if ok2 then
                task.wait(0.9)
                pcall(function()
                    if Q:IsA("RemoteFunction") then Q:InvokeServer(uid) else Q:FireServer(uid) end
                end)
            end
        end)
        task.wait(0.05)
    end

    task.wait(1)
    isCurrentlyHatching = false
    return #ready
end

local function executeMountTreadmill()
