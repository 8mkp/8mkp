-- SISTEMA DE BEAM RAINBOW & HIGHLIGHTS
-- ====================================================================
local rainbowBeam, attach0, attach1, targetPart, currentTargetInstance = nil, nil, nil, nil, nil
local rainbowHue = 0

local function clearBeam()
    if rainbowBeam then pcall(function() rainbowBeam:Destroy() end) rainbowBeam = nil end
    if attach0 then pcall(function() attach0:Destroy() end) attach0 = nil end
    if attach1 then pcall(function() attach1:Destroy() end) attach1 = nil end
    if targetPart then pcall(function() targetPart:Destroy() end) targetPart = nil end
    currentTargetInstance = nil
end

local function createRainbowBeamToTarget(targetObj)
    if not targetObj then return end
    local char = o.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local chest = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso") or root
    local targetPos = getObjectPosition(targetObj)
    if not targetPos then return end

    if currentTargetInstance ~= targetObj or not rainbowBeam then
        clearBeam()
        currentTargetInstance = targetObj

        targetPart = Instance.new("Part")
        targetPart.Name = "SelectedEggRainbowTarget"
        targetPart.Size = Vector3.new(0.1, 0.1, 0.1)
        targetPart.Anchored = true
        targetPart.CanCollide = false
        targetPart.Transparency = 1
        targetPart.Position = targetPos
        targetPart.Parent = Workspace

        attach0 = Instance.new("Attachment", chest)
        attach1 = Instance.new("Attachment", targetPart)

        rainbowBeam = Instance.new("Beam")
        rainbowBeam.Name = "SelectedEggRainbowBeam"
        rainbowBeam.Attachment0 = attach0
        rainbowBeam.Attachment1 = attach1
        rainbowBeam.FaceCamera = true
        rainbowBeam.Width0 = 0.18
        rainbowBeam.Width1 = 0.18
        rainbowBeam.LightEmission = 1
        rainbowBeam.Transparency = NumberSequence.new(0.05)
        rainbowBeam.Color = ColorSequence.new(Color3.fromHSV(rainbowHue, 1, 1))
        rainbowBeam.Parent = root
    end
end

local renderSteppedConnection = RunService.RenderStepped:Connect(function()
    if not rainbowBeam then return end
    rainbowHue = (rainbowHue + 0.02) % 1
    rainbowBeam.Color = ColorSequence.new(Color3.fromHSV(rainbowHue, 1, 1))

    if currentTargetInstance and currentTargetInstance.Parent and targetPart then
        local newPos = getObjectPosition(currentTargetInstance)
        if newPos then targetPart.Position = newPos end
    elseif not (currentTargetInstance and currentTargetInstance.Parent) then
        clearBeam()
    end
end)

local function createHighlight(name, fillColor, outlineColor)
    local hl = Instance.new("Highlight")
    hl.Name = name
    hl.FillColor = fillColor
    hl.OutlineColor = outlineColor
    hl.FillTransparency = 0.45
    hl.OutlineTransparency = 0
    hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    hl.Enabled = false
    hl.Parent = Workspace
    return hl
end

local Top1Highlight = createHighlight("Top1Egg_Highlight", Color3.fromRGB(255, 215, 0), Color3.fromRGB(255, 255, 255))
local SelectedHighlight = createHighlight("SelectedEgg_Highlight", Color3.fromRGB(180, 70, 255), Color3.fromRGB(0, 255, 255))

local function applyHighlights(topRanked, selectedIdx)
    local top1 = topRanked and topRanked[1]
    if top1 then
        local inst1 = resolveEggInstance(top1)
        if inst1 then
            Top1Highlight.Adornee = inst1
            Top1Highlight.Enabled = true
        else
            Top1Highlight.Enabled = false
        end
    else
        Top1Highlight.Enabled = false
    end

    local selectedEgg = (selectedIdx and topRanked and topRanked[selectedIdx])
    if selectedEgg then
        local instSel = resolveEggInstance(selectedEgg)
        if instSel then
            if instSel ~= Top1Highlight.Adornee then
                SelectedHighlight.Adornee = instSel
                SelectedHighlight.Enabled = true
            else
                SelectedHighlight.Enabled = false
            end
            createRainbowBeamToTarget(instSel)
        else
            SelectedHighlight.Enabled = false
            clearBeam()
        end
    else
        SelectedHighlight.Enabled = false
        clearBeam()
    end
end

