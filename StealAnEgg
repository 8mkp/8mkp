-- SISTEMA DE SALVAMENTO AUTOMÁTICO DE CONFIGURAÇÕES (AUTO-SAVE CONFIG)
-- ====================================================================
local CONFIG_FILE_NAME = "SappireHub_Config.json"

function saveConfig()
    pcall(function()
        if not writefile then return end
        local togglesData = {}
        for name, entry in pairs(toggleCallbacks) do
            togglesData[name] = entry.GetState()
        end

        local bindsData = {}
        for bindKey, keyCode in pairs(customKeybinds) do
            if keyCode and keyCode ~= Enum.KeyCode.Unknown then
                bindsData[bindKey] = keyCode.Name
            else
                bindsData[bindKey] = "None"
            end
        end

        local payload = {
            Toggles = togglesData,
            Keybinds = bindsData
        }

        local jsonStr = HttpService:JSONEncode(payload)
        writefile(CONFIG_FILE_NAME, jsonStr)
    end)
end

local function loadConfig()
    pcall(function()
        if not (isfile and readfile and isfile(CONFIG_FILE_NAME)) then return end
        local raw = readfile(CONFIG_FILE_NAME)
        if not raw or raw == "" then return end
        local data = HttpService:JSONDecode(raw)
        if type(data) ~= "table" then return end

        -- Carrega Keybinds salvos
        if type(data.Keybinds) == "table" then
            for bindKey, keyName in pairs(data.Keybinds) do
                if keyName and keyName ~= "None" and Enum.KeyCode[keyName] then
                    customKeybinds[bindKey] = Enum.KeyCode[keyName]
                    if keybindButtons[bindKey] then
                        keybindButtons[bindKey].Text = "[" .. keyName .. "]"
                    end
                elseif keyName == "None" then
                    customKeybinds[bindKey] = Enum.KeyCode.Unknown
                    if keybindButtons[bindKey] then
                        keybindButtons[bindKey].Text = "[None]"
                    end
                end
            end
        end

        -- Carrega Toggles salvos (Tudo inicia desligado por padrao caso nao haja configuracao valida)
        if type(data.Toggles) == "table" then
            for toggleName, state in pairs(data.Toggles) do
                -- Auto Steal e Instant Steal iniciam sempre desligados ao injetar para nao rodar sozinhos
                if toggleName == "Instant Steal" and state == nil then
                    state = true
                end
                if toggleCallbacks[toggleName] and type(state) == "boolean" then
                    toggleCallbacks[toggleName].SetState(state, false)
                end
            end
        end
    end)
end

