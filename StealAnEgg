local function isHoldingTargetEgg(targetUid)
    local char = o.Character
    if not char then return false end

    -- 1. Detecção oficial do evento EggState.CarryChanged (Chilli Hub)
    if SafeCarry and SafeCarry.IsCarrying then
        if targetUid then
            if SafeCarry.CarryUid and SafeCarry.CarryUid == targetUid then
                return true
            end
        else
            return true
        end
    end

    -- 2. Detecção física exata do Chilli Hub: WeldConstraint / JointInstance no modelo do ovo no Workspace
    if targetUid then
        local eggModel = Workspace:FindFirstChild(tostring(targetUid))
        if eggModel then
            for _, desc in ipairs(eggModel:GetDescendants()) do
                if desc:IsA("WeldConstraint") or desc:IsA("JointInstance") then
                    local ok, p0, p1 = pcall(function() return desc.Part0, desc.Part1 end)
                    if ok and ((p0 and p0:IsDescendantOf(char)) or (p1 and p1:IsDescendantOf(char))) then
                        return true
                    end
                end
            end
        end
    end

    -- 3. Verifica Tool equipada NA MÃO (filho direto do Character, nunca mochila)
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local u = item:GetAttribute("UID") or item:GetAttribute("EggUid")
            if targetUid then
                if u == targetUid or item.Name == tostring(targetUid) then
                    return true
                end
            else
                local n = string.lower(item.Name)
                if item:GetAttribute("Category") or item:GetAttribute("ItemType") == "Egg" or n:find("egg") then
                    return true
                end
            end
        end
    end

    return false
end

local function locateTargetEggCFrame(diceTarget)
    if not diceTarget then return nil end
    local uid = diceTarget.Uid
    -- 1. Tenta achar via Modelo físico no Workspace
    if diceTarget.Model and diceTarget.Model.Parent and diceTarget.Model:IsDescendantOf(Workspace) then
        return diceTarget.Model:GetPivot()
    end
    -- 2. Tenta achar ovo solto no chão pelo Uid ou AreaEggSlotsClient
    local areaSlots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if areaSlots and uid then
        local slot = areaSlots:FindFirstChild(tostring(uid))
        if slot and slot:IsA("Model") then
            return slot:GetPivot()
        end
    end
    -- 3. Varredura por ferramentas/ovos dropados no Workspace
    for _, item in ipairs(Workspace:GetChildren()) do
        if item:IsA("Tool") or item:IsA("Model") then
            local u = item:GetAttribute("UID") or item:GetAttribute("EggUid")
            if u and uid and tostring(u) == tostring(uid) then
                return item:GetPivot()
            end
        end
    end
    -- 4. Fallback no CFrame registrado no alvo
    return diceTarget.BoundsCFrame or diceTarget.CFrame
end

