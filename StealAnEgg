-- fn27: Encontra o SmartPromptPart do ovo (Chilli fn27)
local function chilliFindPrompt(uid, eggPos, maxDist)
    local bestDist = maxDist or 14
    local bestPrompt, bestPart = nil, nil
    for _, child in ipairs(Workspace:GetChildren()) do
        if child.Name == "SmartPromptPart" and child:IsA("BasePart") then
            local prompt = child:FindFirstChild("CarryAreaEgg")
            if prompt and prompt:IsA("ProximityPrompt") then
                local d = chilliDist2D(child.Position, eggPos)
                if d < bestDist then
                    bestDist = d
                    bestPrompt = prompt
                    bestPart = child
                end
            end
        end
    end
    if not bestPrompt or not bestPart then return nil, nil end
    if type(uid) == "string" and not chilliValidatePromptPart(bestPart, uid, eggPos) then
        return nil, nil
    end
    return bestPrompt, bestPart
