local function initCombatAndQuickBar()
local autoHitNearestEnabled = false
local autoHitEggHoldersEnabled = false
local hitAuraEnabled = false

local batKeywords = {"bat", "bastao", "katana", "axe", "staff", "club", "hammer", "sword", "blade", "machado", "espada"}

local function isBatTool(item)
    if typeof(item) ~= "Instance" or not item:IsA("Tool") then return false end
    if item:GetAttribute("IsBat") == true then return true end
    local gearName = item:GetAttribute("GearName")
    if type(gearName) == "string" then
        local gLower = string.lower(gearName)
        for _, kw in ipairs(batKeywords) do
            if gLower:find(kw, 1, true) then return true end
        end
    end
    if item:GetAttribute("Category") == "Egg" or item:GetAttribute("ItemType") == "Egg" then
        return false
    end
    local iLower = string.lower(item.Name)
    if iLower:find("egg") or iLower:find("ovo") then return false end
    for _, kw in ipairs(batKeywords) do
        if iLower:find(kw, 1, true) then return true end
    end
    return false
end

local function findBestBatTool()
    local char = o.Character
    if char then
        local equipped = char:FindFirstChildWhichIsA("Tool")
        if equipped and isBatTool(equipped) then
            return equipped
        end
    end
    local bp = Players.LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, item in ipairs(bp:GetChildren()) do
            if isBatTool(item) then
                return item
            end
        end
    end
    return nil
end

local function equipBat(bat)
    local char = o.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 or not bat then return false end
    if bat.Parent == char then return true end
    pcall(function() hum:EquipTool(bat) end)
    if bat.Parent ~= char then
        pcall(function() bat.Parent = char end)
    end
    return bat.Parent == char
end

local function insideBase(pos)
    if not pos then return false end
    local world = Workspace:FindFirstChild("World") or Workspace:FindFirstChild("__OBJECTS")
    local areas = world and world:FindFirstChild("Areas")
    local sepLine = areas and areas:FindFirstChild("SeparationLine")
    local lineX = (sepLine and sepLine:IsA("BasePart") and sepLine.Position.X) or 552.2
    return pos.X < lineX
end

local function isPlayerHittable(targetPlayer)
    if not targetPlayer or targetPlayer == Players.LocalPlayer or targetPlayer.Parent ~= Players then
        return false
    end
    local char = targetPlayer.Character
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    -- Nao acerta quem esta na safe zone / base
    if insideBase(hrp.Position) then return false end

    -- Nao acerta quem ja esta em ragdoll
    local ragdollEnd = tonumber(char:GetAttribute("RagdollEndTime")) or 0
    if ragdollEnd > Workspace:GetServerTimeNow() then return false end

    -- Nao acerta se estiver preso ou em arena de boss
    if char:GetAttribute("IsTrapped") == true or targetPlayer:GetAttribute("InBossArena") then
        return false
    end

    return true
end

local function isPlayerHoldingEgg(targetPlayer)
    if not isPlayerHittable(targetPlayer) then return false end
    local char = targetPlayer.Character
    if not char then return false end

    -- 1. Verifica tool de ovo equipada na mao
    for _, item in ipairs(char:GetChildren()) do
        if item:IsA("Tool") then
            local u = item:GetAttribute("UID") or item:GetAttribute("EggUid")
            local n = string.lower(item.Name)
            if u or item:GetAttribute("Category") == "Egg" or item:GetAttribute("ItemType") == "Egg" or n:find("egg") or n:find("ovo") then
                return true
            end
        end
    end

    -- 2. Verifica welds/joints em ovos no Workspace
    for _, obj in ipairs(Workspace:GetChildren()) do
        if obj:IsA("Model") and (#obj.Name == 32 or obj.Name:find("Egg") or obj.Name:find("ovo")) then
            for _, desc in ipairs(obj:GetDescendants()) do
                if desc:IsA("WeldConstraint") or desc:IsA("JointInstance") then
                    local ok, p0, p1 = pcall(function() return desc.Part0, desc.Part1 end)
                    if ok and ((p0 and p0:IsDescendantOf(char)) or (p1 and p1:IsDescendantOf(char))) then
                        return true
                    end
                end
            end
        end
    end

    return false
end

