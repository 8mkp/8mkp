local SelectedHighlight = createHighlight("SelectedEgg_Highlight", Color3.fromRGB(180, 70, 255), Color3.fromRGB(0, 255, 255))

local function applyHighlights(topRanked, selectedIdx)
    local top1 = topRanked and topRanked[1]
    if top1 then
        local inst1 = resolveEggInstance(top1)
        if inst1 then
            Top1Highlight.Adornee = inst1
            Top1Highlight.Enabled = true
        else
            Top1Highlight.Enabled = false
        end
    else
        Top1Highlight.Enabled = false
    end

    local selectedEgg = (selectedIdx and topRanked and topRanked[selectedIdx])
    if selectedEgg then
        local instSel = resolveEggInstance(selectedEgg)
        if instSel then
            if instSel ~= Top1Highlight.Adornee then
                SelectedHighlight.Adornee = instSel
                SelectedHighlight.Enabled = true
            else
                SelectedHighlight.Enabled = false
            end
            createRainbowBeamToTarget(instSel)
        else
            SelectedHighlight.Enabled = false
            clearBeam()
        end
    else
        SelectedHighlight.Enabled = false
        clearBeam()
    end
end

