    return petName, rarityName, petCategory, baseRate, iconAsset
end

-- Renderiza o Modelo 3D ao Vivo dentro de qualquer Frame da UI
local function attachPetViewport(containerFrame, petCategory)
    if not AssetViewport or not containerFrame then
        return false
    end

    if not petCategory or petCategory == "" then
        return false
    end

    -- Se já tem o preview do mesmo pet ativo, não recria
    if containerFrame:GetAttribute("RenderedCategory") == petCategory and containerFrame:FindFirstChild("PreviewViewport") then
        return true
    end

    -- 1. Limpa qualquer preview antigo que já esteja dentro do frame
    for _, child in ipairs(containerFrame:GetChildren()) do
        if child:IsA("ViewportFrame") or child.Name == "AssetViewport" or child.Name == "PreviewViewport" then
            pcall(function() child:Destroy() end)
        end
    end

    -- 2. Monta o ViewportFrame oficial calibrado com câmera e iluminação
    local okMount, viewport = pcall(function()
        return AssetViewport.Mount(containerFrame)
    end)

    if not okMount or not viewport then
        return false
    end

    -- 3. Configura o posicionamento para preencher o container perfeitamente
    viewport.Name = "PreviewViewport"
    viewport.Size = UDim2.fromScale(1, 1)
    viewport.Position = UDim2.fromScale(0.5, 0.5)
    viewport.AnchorPoint = Vector2.new(0.5, 0.5)
    viewport.BackgroundTransparency = 1
    viewport.ZIndex = (containerFrame.ZIndex or 1) + 2

    -- 4. Injeta o modelo 3D do bicho dentro do ViewportFrame
    local okShow = pcall(function()
        return AssetViewport.ShowAsset(petCategory, viewport, true)
    end)

    if not okShow then
        pcall(function() viewport:Destroy() end)
        containerFrame:SetAttribute("RenderedCategory", nil)
        return false
    end

    containerFrame:SetAttribute("RenderedCategory", petCategory)
    return true
end

