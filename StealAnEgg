-- ====================================================================
-- ATUALIZAÇÃO DOS DADOS & GATILHO ESTRITO DE NOTIFICAÇÃO
-- ====================================================================
local function updateRanking()
    if isDestroyed then return end

    local data = nil
    if EggState then
        local s, res = pcall(function() return EggState:ReadFieldEggs() end)
        if s and res and res.Records then
            data = res
        else
            local s2, res2 = pcall(function() return EggState.ReadFieldEggs() end)
            if s2 and res2 and res2.Records then data = res2 end
        end
    end

    if not (data and data.Records) then return end

    local ranked = {}
    local processed = {}

    for slotKey, rec in pairs(data.Records) do
        local isCarried = false
        if rec.State ~= nil then
            local stateVal = rec.State
            local stateStr = tostring(stateVal):lower()
            if stateStr:find("carr") or stateStr:find("held") or stateStr:find("pick") or stateVal == 2 then 
                isCarried = true 
            end
            if stateStr ~= "slot" and stateStr ~= "dropped" and stateStr ~= "guardcarried" and stateVal ~= 1 then
                isCarried = true
            end
        end
        if rec.Carrier and rec.Carrier ~= false and rec.Carrier ~= 0 and rec.Carrier ~= "" then isCarried = true end
        if rec.CarrierUserId and type(rec.CarrierUserId) == "number" and rec.CarrierUserId > 0 then isCarried = true end
        if rec.IsCarried == true or rec.Removed == true or rec.Active == false then isCarried = true end

        local uid = rec.Uid or slotKey

        -- Checa disponibilidade no DICE_ENGINE se disponivel
        if not isCarried and DICE_ENGINE and typeof(DICE_ENGINE.v63) == "function" then
            local avail, status = DICE_ENGINE.v63(uid)
            if not avail and status == "CarriedByOther" then
                isCarried = true
            end
        end

        local uid = rec.Uid or slotKey

        if not isCarried and not processed[uid] then
            processed[uid] = true

            local category = rec.AssetCategory or "Unknown"
            local cfg = getPetConfig(category)

            local baseRate = (cfg and cfg.EarningRate) or 0
            local englishName = (cfg and cfg._id) or (cfg and cfg.DisplayName) or category
            local rarityName = (cfg and cfg.Rarity and (cfg.Rarity._id or cfg.Rarity.DisplayName)) or "Common"
            local iconAsset = (cfg and type(cfg.Icon) == "string" and cfg.Icon) or ""

            local scale = rec.AssetScale or 1
            local mutation = rec.BaseMutation or "Normal"
            local mutBonus = mutationMultipliers[mutation] or 1.0

            local realIncome = baseRate * (scale ^ SCALE_POWER) * mutBonus
            local priority = rarityPriority[rarityName] or (mutation == "Eternal" and 110) or 0

            local targetCF = rec.BoundsCFrame or rec.BottomCFrame or rec.CFrame or CFrame.new()

            local eggEntry = {
                uid = uid,
                slotKey = slotKey,
                instance = rec.Instance or rec.Model or rec.EggInstance,
                CFrame = targetCF,
                BoundsCFrame = rec.BoundsCFrame,
                name = englishName,
                rarity = rarityName,
                priority = priority,
                mutation = mutation,
                scale = scale,
                income = realIncome,
                formattedIncome = formatIncome(realIncome),
                icon = iconAsset
            }

            -- VALIDAÇÃO FÍSICA NO MAPA: Se o ovo não existe fisicamente no Workspace ou já foi roubado, não exibe na lista!
            local inst = resolveEggInstance(eggEntry)
            local pos = targetCF and targetCF.Position
            local inField = pos and (pos.X >= 530)
            if inst and inst.Parent and inst:IsDescendantOf(Workspace) and inField then
                eggEntry.instance = inst
                table.insert(ranked, eggEntry)
            end

            -- ========================================================
            -- FILTRO ESTRITO:
            -- 1. Divino ou Eterno: SEMPRE NOTIFICA
            -- 2. Secret: APENAS SE >= 600M
            -- ========================================================
            local rLower = rarityName:lower()
            local mLower = mutation:lower()
            local nLower = englishName:lower()

            local isDivine = rLower:find("divin") or nLower:find("divino")
            local isEternal = rLower:find("etern") or mLower:find("etern") or nLower:find("eterno") or nLower:find("bico eterno")
            local isSecret = rLower:find("secret") or nLower:find("secret")

            local shouldNotify = false
            local embedColor = 11482111

            if isEternal then
                shouldNotify = true
                embedColor = 53011
            elseif isDivine then
                shouldNotify = true
                embedColor = 16766720
            elseif isSecret and realIncome >= 600e6 then
                shouldNotify = true
                embedColor = 13382655
            end

            if shouldNotify and not notifiedEggsCache[uid] then
                notifiedEggsCache[uid] = true
                showTargetNotification(eggEntry)

                task.spawn(function()
                    local publicImage = resolvePublicImageUrl(iconAsset)
                    sendHttp({
                        content = string.format("<@&%s>", ROLE_ID),
                        embeds = {{
                            title = string.format("🥚 %s", englishName),
                            color = embedColor,
                            fields = {
                                {
                                    name = "💰 Geração / Seg",
                                    value = string.format("**%s/s**", formatIncome(realIncome)),
                                    inline = true
                                },
                                {
                                    name = "📏 Tamanho",
                                    value = string.format("**%.2fx**", scale),
                                    inline = true
                                },
                                {
                                    name = "✨ Raridade",
                                    value = string.format("**%s**%s", rarityName, (mutation ~= "Normal") and (" (" .. mutation .. ")") or ""),
                                    inline = true
                                },
                                {
                                    name = "📍 Posição",
                                    value = string.format("`X: %.1f | Y: %.1f | Z: %.1f`", targetCF.Position.X, targetCF.Position.Y, targetCF.Position.Z),
                                    inline = false
                                }
                            },
                            thumbnail = publicImage and { url = publicImage } or nil,
                            footer = {
                                text = "Sappire Hub • Target Radar"
                            },
                            timestamp = DateTime.now():ToIsoDate()
                        }}
                    })
                end)
            end
        end
    end

    table.sort(ranked, function(a, b)
        if a.priority ~= b.priority then return a.priority > b.priority end
        return a.income > b.income
    end)

    currentTopData = ranked

    for i = 1, 5 do
        local el = cardElements[i]
        local info = ranked[i]
        if info and el then
            el.NameLabel.Text = info.name
            el.RarityLabel.Text = (info.mutation ~= "Normal") and string.format("%s (%s)", info.rarity, info.mutation) or info.rarity
            el.RarityLabel.TextColor3 = rarityColors[info.rarity] or Color3.fromRGB(168, 85, 247)
            el.MultLabel.Text = string.format("%.2fx", info.scale)
            el.IncomeLabel.Text = info.formattedIncome
            if info.icon ~= "" then el.PetImage.Image = info.icon end
            el.Card.Visible = true
        elseif el then
            el.Card.Visible = false
        end
    end

    refreshSelection()
end

