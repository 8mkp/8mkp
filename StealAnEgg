local function restoreCharacterMovement()
    local char = o.Character
    if not char then return end

    -- Remove soldas rigidas injetadas pelo anti-ragdoll que deixam bracos e pernas duros
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("WeldConstraint") and desc.Name:find("RigidJointWeld_") then
            pcall(function() desc:Destroy() end)
        end
        if desc:IsA("Motor6D") then
            desc.Enabled = true
        end
        if desc:IsA("BasePart") then
            desc.CanTouch = true
            if desc.Name ~= "HumanoidRootPart" then
                desc.CanCollide = true
            end
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.AutoRotate = true
        hum.PlatformStand = false
        hum.Sit = false
        hum.WalkSpeed = math.max(16, hum.WalkSpeed)
        hum.JumpPower = math.max(50, hum.JumpPower)
        hum:SetStateEnabled(Enum.HumanoidStateType.Running, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end

    if hrp then
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local selectedFarmMode = "TP" -- "TP" ou "Fly"

GoButton.MouseButton1Click:Connect(function()
    local targetEgg = (selectedIndex and currentTopData[selectedIndex]) or currentTopData[1]
    if targetEgg then
        local inst = resolveEggInstance(targetEgg)
        if inst then
            createRainbowBeamToTarget(inst)
            showTargetNotification(targetEgg)
        end
        local session = DICE_ENGINE.bump_session()
        local diceTarget = {
            Uid = targetEgg.uid or targetEgg.Uid,
            CFrame = targetEgg.CFrame or targetEgg.BoundsCFrame or resolveTargetCFrame(targetEgg),
            Model = inst or (targetEgg.instance or targetEgg.Model),
            BoundsCFrame = targetEgg.BoundsCFrame or targetEgg.CFrame,
            AreaId = targetEgg.area or targetEgg.Area or "Lake"
        }
        task.spawn(function()
            if selectedFarmMode == "Fly" then
                -- ========================================================
                -- AUTO STEAL FLY MODE (MESMO FLY DE RETORNO PARA IR)
                -- ========================================================
                print("[Sappire Hub] Executando Auto Steal no modo FLY...")
                DICE_ENGINE.v50["autoFarmLoop"] = true
                pcall(DICE_ENGINE.v60)

                local char = o.Character
                local hrp = char and char:FindFirstChild("HumanoidRootPart")
                local hum = char and char:FindFirstChildOfClass("Humanoid")

                if char and hrp then
                    if not DICE_ENGINE.v50["swapped"] and DICE_ENGINE.v94 then DICE_ENGINE.v94() end
                    if not DICE_ENGINE.v50["godmode"] and DICE_ENGINE.v93 then DICE_ENGINE.v93(true) end
                    if DICE_ENGINE.v96 then DICE_ENGINE.v96(char) end
                    if hum then hum.AutoRotate = false end

                    local targetFlyCF = (diceTarget.CFrame or CFrame.new()) * CFrame.new(0, 0.4, 0)
                    local targetPos = targetFlyCF.Position
                    pcall(function() Players.LocalPlayer:RequestStreamAroundAsync(targetPos) end)

                    -- 1. VOO SUAVE ATE O OVO ALVO (Igual a dinamica do voo de retorno)
                    local speed = DICE_ENGINE.v50["glideSpeed"] or 850
                    local tFlyMax = os.clock() + 15
                    while char.Parent and hrp.Parent and os.clock() < tFlyMax do
                        local curPos = hrp.Position
                        local dist = (targetPos - curPos).Magnitude
                        if dist <= 5 then
                            hrp.CFrame = targetFlyCF
                            hrp.AssemblyLinearVelocity = Vector3.zero
                            hrp.AssemblyAngularVelocity = Vector3.zero
                            break
                        end
                        local dt = RunService.Heartbeat:Wait()
                        local step = math.min(dist, speed * dt)
                        local dir = (targetPos - curPos).Unit
                        local nextP = curPos + (dir * step)
                        hrp.CFrame = CFrame.lookAt(nextP, nextP + dir)
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        hrp.AssemblyAngularVelocity = Vector3.zero
                    end
                    hrp.CFrame = targetFlyCF

                    pcall(playTeleportSound)

                    local function triggerGrab()
                        if DICE_ENGINE.v98 then DICE_ENGINE.v98(diceTarget.Model, targetPos) end
                        if diceTarget.Uid and DICE_ENGINE.v24 then
                            task.spawn(function()
                                pcall(function()
                                    if DICE_ENGINE.v24:IsA("RemoteFunction") then
                                        DICE_ENGINE.v24:InvokeServer({ Uid = diceTarget.Uid })
                                        DICE_ENGINE.v24:InvokeServer(diceTarget.Uid)
                                    else
                                        DICE_ENGINE.v24:FireServer({ Uid = diceTarget.Uid })
                                        DICE_ENGINE.v24:FireServer(diceTarget.Uid)
                                    end
                                end)
                            end)
                        end
                    end

                    -- 2. PEGA O OVO MAIS VALIOSO (1a VEZ)
                    print("[Sappire Hub] [Fly] Chegou no alvo! Pegando o ovo (1a vez)...")
                    local t1 = os.clock() + 3.0
                    while not ((DICE_ENGINE.v61 and DICE_ENGINE.v61()) or (DICE_ENGINE.v62 and DICE_ENGINE.v62(diceTarget.Uid))) and os.clock() < t1 do
                        char:PivotTo(targetFlyCF)
                        if DICE_ENGINE.v96 then DICE_ENGINE.v96(char) end
                        triggerGrab()
                        task.wait(0.04)
                    end

                    -- 3. ESPERA O BOSS / GUARD DAR O HIT
                    print("[Sappire Hub] [Fly] 1a pegada feita! Chamando e aguardando o hit do boss/guarda...")
                    local guardCF = hrp.CFrame * CFrame.new(0, 0, -3)
                    if DICE_ENGINE.v28 then
                        task.spawn(function()
                            pcall(function()
                                if DICE_ENGINE.v28:IsA("RemoteFunction") then
                                    DICE_ENGINE.v28:InvokeServer({ EggUid = diceTarget.Uid, GuardCFrame = guardCF })
                                    DICE_ENGINE.v28:InvokeServer()
                                else
                                    DICE_ENGINE.v28:FireServer({ EggUid = diceTarget.Uid, GuardCFrame = guardCF })
                                    DICE_ENGINE.v28:FireServer()
                                end
                            end)
                        end)
                    end
                    if DICE_ENGINE.v67 then DICE_ENGINE.v67(diceTarget.Uid) end

                    -- Aguarda o golpe físico do boss (1.2s garantido) mantendo o boneco firme e duro
                    local tHit = os.clock() + 1.2
                    while os.clock() < tHit do
                        char:PivotTo(targetFlyCF)
                        if DICE_ENGINE.v96 then DICE_ENGINE.v96(char) end
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        task.wait(0.03)
                    end

                    -- 4. LOGO APOS O HIT, PEGA MAIS 1 VEZ O OVO (2a VEZ / RE-GRAB)
                    -- Fica tentando ate confirmar que o ovo esta em maos/mochila (timeout 4.5s)
                    print("[Sappire Hub] [Fly] Hit do boss efetuado! Pegando o ovo mais 1 vez (2a pegada)...")
                    local gotSecond = false
                    local t2 = os.clock() + 4.5
                    while os.clock() < t2 do
                        char:PivotTo(targetFlyCF)
                        if DICE_ENGINE.v96 then DICE_ENGINE.v96(char) end
                        hrp.AssemblyLinearVelocity = Vector3.zero
                        triggerGrab()
                        task.wait(0.04)
                        if (DICE_ENGINE.v61 and DICE_ENGINE.v61()) or (DICE_ENGINE.v62 and DICE_ENGINE.v62(diceTarget.Uid)) then
                            gotSecond = true
                            break
                        end
                    end

                    if gotSecond then
                        print("[Sappire Hub] [Fly] 2a pegada confirmada! Guardando na mochila e iniciando retorno...")
                        -- Pequena pausa para o servidor sincronizar antes do retorno
                        task.wait(0.15)
                        pcall(DICE_ENGINE.v60)
                        task.wait(0.08)

                        -- 5. EXECUTA O SISTEMA DE RETORNO OFICIAL (Exatamente igual ao TP)
                        print("[Sappire Hub] [Fly] Ovo capturado com sucesso! Executando sistema de volta oficial...")
                        if autoPlaceEggEnabled then
                            pcall(function()
                                DICE_ENGINE.v75(DICE_ENGINE.v50["glideSpeed"] or 850, session, true)
                            end)
                        else
                            pcall(function()
                                DICE_ENGINE.v79(DICE_ENGINE.v50["glideSpeed"] or 850, session)
                            end)
                        end

                        if autoTreadmillEnabled then
                            task.wait(0.2)
                            pcall(executeMountTreadmill)
                        end

                        print("[Sappire Hub] Retorno concluido! Personagem em seguranca.")
                        if not autoTreadmillEnabled then
                            task.wait(0.1)
                            pcall(restoreCharacterMovement)
                        end
                    else
                        print("[Sappire Hub] [Fly] Timeout na 2a pegada. Retornando sem o ovo...")
                        task.wait(0.1)
                        pcall(restoreCharacterMovement)
                    end
                else
                    task.wait(0.1)
                    pcall(restoreCharacterMovement)
                end

                DICE_ENGINE.v50["autoFarmLoop"] = false
            else
                -- ========================================================
                -- AUTO STEAL TP MODE (WARP NOYCHOX TELEPORT 100% ORIGINAL)
                -- ========================================================
                print("[Sappire Hub] Executando Auto Steal no modo TP (Warp)...")
                DICE_ENGINE.v50["autoFarmLoop"] = true

                local success = DICE_ENGINE.v83(diceTarget, session)
                if success then
                    print("[Sappire Hub] Ovo capturado com sucesso! Executando sistema de volta oficial...")
                    
                    -- Se o toggle 'Auto Place Egg' estiver ativado no menu:
                    if autoPlaceEggEnabled then
                        pcall(function()
                            DICE_ENGINE.v75(DICE_ENGINE.v50["glideSpeed"] or 850, session, true)
                        end)
                    else
                        -- Sistema oficial de volta do DiceHub (Retorno à linha segura X=525 pela highway Z=-360 desviando de armadilhas)
                        pcall(function()
                            DICE_ENGINE.v79(DICE_ENGINE.v50["glideSpeed"] or 850, session)
                        end)
                    end

                    -- Se 'Auto TreadMill' estiver ativado:
                    if autoTreadmillEnabled then
                        task.wait(0.2)
                        pcall(executeMountTreadmill)
                    end

                    print("[Sappire Hub] Retorno concluido! Personagem em seguranca.")
                    if not autoTreadmillEnabled then
                        task.wait(0.1)
                        pcall(restoreCharacterMovement)
                    end
                else
                    print("[Sappire Hub] Teleport cancelado ou falhou na captura.")
                    task.wait(0.1)
                    pcall(restoreCharacterMovement)
                end

                DICE_ENGINE.v50["autoFarmLoop"] = false
            end
        end)
    end
end)

