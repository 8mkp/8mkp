-- Busca de paredes do Chilli Hub
local function getCombatWalls()
    if os.clock() < combatState.WallsAt then
        return combatState.Walls
    end
    combatState.WallsAt = os.clock() + 5
    local walls = {}
    local world = Workspace:FindFirstChild("World") or Workspace:FindFirstChild("__OBJECTS")
    local build = world and world:FindFirstChild("Build")
    if build then
        for _, child in ipairs(build:GetChildren()) do
            local collisions = child:FindFirstChild("COLLISIONS")
            local guard = collisions and collisions:FindFirstChild("GUARD NO COLLIDE")
            if guard then
                for _, child2 in ipairs(guard:GetChildren()) do
                    if combatWallNames[child2.Name] then
                        if child2:IsA("BasePart") then
                            table.insert(walls, child2)
                        end
                        for _, desc in ipairs(child2:GetDescendants()) do
                            if desc:IsA("BasePart") then
                                table.insert(walls, desc)
                            end
                        end
                    end
                end
            end
        end
    end
    combatState.Walls = walls
    return walls
end

local function getAxisOrder(v)
    if v.X <= v.Y and v.X <= v.Z then return "X", "Y", "Z" end
    if v.Y <= v.Z then return "Y", "X", "Z" end
    return "Z", "X", "Y"
end

local function getDominantAxis(cf)
    local x = math.abs(cf.RightVector.Y)
    local y = math.abs(cf.UpVector.Y)
    local z = math.abs(cf.LookVector.Y)
    if x >= y and x >= z then return "X" end
    if y >= z then return "Y" end
    return "Z"
end

local function checkAxisOverlap(pt, halfSize, axis, domAxis)
    if axis == domAxis then return true end
    local bound = halfSize[axis] + 6
    return math.abs(pt[axis]) <= bound
end

local function avoidWallsStep(fromPos, toPos)
    for _, wall in ipairs(getCombatWalls()) do
        if wall.Parent then
            local cf = wall.CFrame
            local size = wall.Size
            local a1, a2, a3 = getAxisOrder(size)
            local dom = getDominantAxis(cf)
            local half = size / 2
            local toObj = cf:PointToObjectSpace(toPos)
            if checkAxisOverlap(toObj, half, a2, dom) and checkAxisOverlap(toObj, half, a3, dom) then
                local fromObj = cf:PointToObjectSpace(fromPos)
                local distSide = math.abs(fromObj[a1])
                local curSide = combatState.WallSide[wall]
                if distSide >= half[a1] + 3 or (curSide == nil and distSide >= half[a1]) then
                    curSide = (fromObj[a1] >= 0) and 1 or -1
                    combatState.WallSide[wall] = curSide
                elseif curSide == nil then
                    curSide = (fromObj[a1] >= 0) and 1 or -1
                end
                local threshold = half[a1] + 6
                if toObj[a1] * curSide < threshold then
                    local adj = {X = toObj.X, Y = toObj.Y, Z = toObj.Z, [a1] = curSide * threshold}
                    toPos = cf:PointToWorldSpace(Vector3.new(adj.X, adj.Y, adj.Z))
                end
            end
        end
    end
    return toPos
end

local function combatKeepOffWalls(fromPos, toPos)
    local nextPos = avoidWallsStep(fromPos, toPos)
    local delta = nextPos - fromPos
    if delta.Magnitude > 6 then
        local cur = fromPos
        for i = 1, 6 do
            local sample = fromPos + delta * i / 6
            local step = avoidWallsStep(cur, sample)
            if (step - sample).Magnitude > 0.01 then
                return avoidWallsStep(fromPos, step)
            end
            cur = step
        end
    end
    return nextPos
end

-- Raycast do chão do Chilli Hub (fn48)
local combatRayLastTime = 0
local combatRayLastChar = nil
local function combatClampToGround(pos)
    local char = o.Character
    if os.clock() - combatRayLastTime > 0.5 or char ~= combatRayLastChar then
        combatRayLastTime = os.clock()
        combatRayLastChar = char
        local filter = {}
        for _, pl in ipairs(Players:GetPlayers()) do
            if pl.Character then
                table.insert(filter, pl.Character)
            end
        end
        combatRayParams.FilterDescendantsInstances = filter
    end
    local hit = Workspace:Raycast(pos + Vector3.new(0, 60, 0), Vector3.new(0, -400, 0), combatRayParams)
    if hit and pos.Y < hit.Position.Y + 3 then
        return Vector3.new(pos.X, hit.Position.Y + 3, pos.Z)
    end
    return pos
end

-- Rastreamento de velocidade e direção do alvo do Chilli Hub (fn49)
local function combatTrackTarget(targetKey, targetHrp)
    local track = combatState.Tracks[targetKey]
    if not track then
        track = {Samples = {}, Smooth = nil, Heading = nil}
        combatState.Tracks[targetKey] = track
    end
    local now = os.clock()
    local samples = track.Samples
    table.insert(samples, {Time = now, Position = targetHrp.Position})
    while #samples > 2 and (now - samples[1].Time) > 0.12 do
        table.remove(samples, 1)
    end
    local linVel = targetHrp.AssemblyLinearVelocity
    local first = samples[1]
    local dtSample = now - first.Time
    local estVel
    if dtSample >= 0.03 then
        estVel = (targetHrp.Position - first.Position) / dtSample
        if not (estVel.Magnitude <= 1500 and linVel.Magnitude <= estVel.Magnitude * 1.4) then
            estVel = linVel
        end
    else
        estVel = linVel
    end
    local velXZ = Vector3.new(estVel.X, 0, estVel.Z)
    track.Smooth = track.Smooth and track.Smooth:Lerp(velXZ, 0.25) or velXZ
    local smooth = track.Smooth
    if smooth.Magnitude > 1 then
        local head = track.Heading and track.Heading:Lerp(smooth.Unit, 0.25) or smooth.Unit
        track.Heading = (head.Magnitude > 0.01) and head.Unit or smooth.Unit
    end
    return estVel, velXZ, smooth, track
end

-- Escolha adaptativa de ping do Chilli Hub (fn50)
local function getAdaptivePingOption()
    local total = 0
    for _, st in ipairs(combatState.Stats) do total = total + st.Shots end
    local bestOption = combatState.Option
    local bestScore = -math.huge
    for i, st in ipairs(combatState.Stats) do
        local n34 = st.Shots + 1
        local score = (st.Hits + 1) / (st.Shots + 2) + math.sqrt(2 * math.log(total + 2) / n34) * 0.35
        if score > bestScore then
            bestScore = score
            bestOption = i
        end
    end
    combatState.Option = bestOption
    return bestOption
end

-- Algoritmo exato combat.Plan do Chilli Hub
local function combatPlan(targetPlayer, myHrp)
    local tChar = targetPlayer and targetPlayer.Character
    local tHrp = tChar and tChar:FindFirstChild("HumanoidRootPart")
    local tHum = tChar and tChar:FindFirstChildOfClass("Humanoid")
    if not tHrp or not tHum or tHum.Health <= 0 then return nil end

    local ping = math.clamp(Players.LocalPlayer:GetNetworkPing(), 0, 1)
    local pingDelay = math.clamp(ping + 0.05, 0.05, 0.35)
    local estVel, velXZ, smoothVel, track = combatTrackTarget(targetPlayer, tHrp)
    local optIdx = getAdaptivePingOption()
    local optDelay = combatPingOptions[optIdx]

    local tPos = tHrp.Position
    local histPos = tPos + estVel * math.max(0, optDelay + ping - pingDelay)
    local curPos = tPos + estVel * (optDelay + ping)
    local velMag = smoothVel.Magnitude

    local head = track.Heading
    if not head then
        local diffXZ = Vector3.new(myHrp.Position.X - tPos.X, 0, myHrp.Position.Z - tPos.Z)
        head = (diffXZ.Magnitude > 0.1) and diffXZ.Unit or Vector3.new(0, 0, 1)
    end

    local batTool = findBestBatTool()
    local batBonus = 0
    local eventMult = (Workspace:GetAttribute("DragonEggEventActive") == true) and 2.5 or 1
    local batRange = (15 + 2 + batBonus) * eventMult

    local leadPt = tPos + smoothVel * (ping + optDelay + 0.18 - 0.275) + ((velMag > 1) and (smoothVel.Unit * 6 * 0.6) or Vector3.zero)
    local sweepDist = math.max(5, math.min(batRange * 0.7, 6 + velMag * 0.07)) * 0.6
    local now = os.clock()
    local sweepOffset = (math.sin(now * 2 * math.pi / 1.1) * 0.5 + 0.5) * sweepDist
    local bobOffset = math.sin(now * 2 * math.pi / 0.8) * 2.5

    local sideVec = Vector3.new(-head.Z, 0, head.X)
    if sideVec:Dot(myHrp.Position - leadPt) < 0 then
        sideVec = -sideVec
    end

    local targetGoal = leadPt + head * sweepOffset + sideVec * ((velXZ.Magnitude < 35) and 3 or 1.5) + Vector3.new(0, bobOffset, 0)
    local finalGoal = combatKeepOffWalls(myHrp.Position, combatClampToGround(targetGoal))

    return {
        Goal = finalGoal,
        Velocity = Vector3.new(smoothVel.X, 0, smoothVel.Z),
        Face = curPos,
        Current = curPos,
        Historical = histPos,
        Option = optIdx,
        Distance = (tPos - myHrp.Position).Magnitude
    }
end

-- Algoritmo exato combat.Steer do Chilli Hub
local function combatSteer(hrp, plan, speed, maxSpeed, dt)
    local dtVal = math.max(dt, 0.0041666)
    local vel = plan.Velocity
    local stepVel = vel + (plan.Goal - hrp.Position) / math.max(0.12, dtVal)
    local cap = math.min(speed + vel.Magnitude, maxSpeed)
    if stepVel.Magnitude > cap then
        stepVel = stepVel.Unit * cap
    end

    local curPos = hrp.Position
    local nextPos = curPos + stepVel * dtVal
    local walledNext = combatKeepOffWalls(curPos, nextPos)
    if (walledNext - nextPos).Magnitude > 0.01 then
        stepVel = (walledNext - curPos) / dtVal
    end
    local walledCur = combatKeepOffWalls(curPos, curPos)
    if (walledCur - curPos).Magnitude > 0.01 then
        stepVel = (walledCur - curPos) / math.max(0.12, dtVal)
    end

    local finalLinVel = stepVel + Vector3.new(0, Workspace.Gravity * dtVal * 0.5, 0)

    pcall(function()
        local faceDir = Vector3.new(plan.Face.X - curPos.X, 0, plan.Face.Z - curPos.Z)
        if faceDir.Magnitude > 0.05 then
            hrp.CFrame = CFrame.lookAt(curPos, curPos + faceDir.Unit)
        end
        hrp.AssemblyLinearVelocity = finalLinVel
        hrp.AssemblyAngularVelocity = Vector3.zero
    end)
end

-- Algoritmo exato combat.TryHit do Chilli Hub / Referência (steal_a_egg_v2 linhas 7287-7312)
local function combatTryHit(targetPlayer, plan)
    if Workspace:GetAttribute("PvPDisabled") == true then return false end
    local char = o.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then return false end

    local bat = findBestBatTool()
    if not bat then return false end
    if not equipBat(bat) then return false end

    if not isPlayerHittable(targetPlayer) or isTargetRagdolled(targetPlayer) then
        return false
    end

    plan = plan or combatPlan(targetPlayer, hrp)
    if not plan then return false end

    local eventMult = (Workspace:GetAttribute("DragonEggEventActive") == true) and 2.5 or 1
    local batRange = (15 + 2) * eventMult - 1
    local samplePos = hrp.Position - hrp.AssemblyLinearVelocity * 0.18
    if (plan.Historical - samplePos).Magnitude > batRange and (plan.Current - samplePos).Magnitude > batRange then
        return false
    end

    local trigger = getCombatBatTrigger()
    if not trigger then return false end

    local ping = math.clamp(Players.LocalPlayer:GetNetworkPing(), 0, 1)
    local cooldownEnd = tonumber(bat:GetAttribute("CooldownEndTime")) or 0
    if getCombatServerTime() < cooldownEnd - ping * 0.5 then
        return false
    end

    local now = os.clock()
    if now - combatState.LastFire < math.max(0.12, ping * 1.5) then
        return false
    end

    combatState.LastFire = now
    combatState.Trace = combatState.Trace + 1

    table.insert(combatState.Pending, {
        Target = targetPlayer,
        Option = plan.Option,
        At = now,
        Wait = math.max(0.5, ping * 2 + 0.3),
        RagdollBefore = getPlayerRagdollEndTime(targetPlayer.Character),
        CooldownBefore = cooldownEnd,
        Tool = bat
    })

    local traceStr = string.format("%d:%d:%d", Players.LocalPlayer.UserId, combatState.Trace, math.floor(getCombatServerTime() * 1000))
    pcall(function()
        trigger:FireServer(targetPlayer, traceStr)
    end)
    return true
end

-- Algoritmo exato combat.Swing do Chilli Hub / Referência (steal_a_egg_v2 linhas 7315-7329)
local function combatSwing()
    if isAutoStealActive or (SafeCarry and SafeCarry.IsCarrying) then
        return false
    end
    local now = os.clock()
    if now - combatState.LastFire < 0.3 then
        return false
    end
    if now - (combatState.LastSwing or 0) < 0.15 then
        return false
    end

    local char = o.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum or hum.Health <= 0 then
        return false
    end

    local bat = findBestBatTool()
    if not bat or not equipBat(bat) then
        return false
    end

    combatState.LastSwing = now
    pcall(function()
        bat:Activate()
    end)
    return true
end

-- Limpeza de estatísticas de acerto (fn51)
local function combatCleanPending()
    local now = os.clock()
    for i = #combatState.Pending, 1, -1 do
        local item = combatState.Pending[i]
        local st = combatState.Stats[item.Option]
        if st then
            if (item.RagdollBefore + 0.01) < getPlayerRagdollEndTime(item.Target and item.Target.Character) then
                st.Hits = st.Hits + 1
                st.Shots = st.Shots + 1
                table.remove(combatState.Pending, i)
            elseif item.Wait < (now - item.At) then
                if (item.Tool and (tonumber(item.Tool:GetAttribute("CooldownEndTime")) or 0)) > (item.CooldownBefore + 0.01) then
                    st.Shots = st.Shots + 1
                end
                table.remove(combatState.Pending, i)
            end
        else
            table.remove(combatState.Pending, i)
        end
    end
end

