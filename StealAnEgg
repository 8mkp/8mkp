local combatGodStates = {
    Enum.HumanoidStateType.FallingDown,
    Enum.HumanoidStateType.Ragdoll,
    Enum.HumanoidStateType.Physics,
    Enum.HumanoidStateType.Seated,
    Enum.HumanoidStateType.PlatformStanding,
}
local combatSavedCollisions = {}
local combatGodModeActive = false

local function combatGodMode(enable)
    local char = o.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not char or not hum then return end

    if enable then
        combatGodModeActive = true
        for _, st in ipairs(combatGodStates) do
            pcall(function() hum:SetStateEnabled(st, false) end)
        end
        pcall(function() hum.BreakJointsOnDeath = false end)
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("BasePart") and combatSavedCollisions[desc] == nil then
                combatSavedCollisions[desc] = desc.CanCollide
                pcall(function() desc.CanCollide = false end)
            end
        end
    elseif combatGodModeActive then
        combatGodModeActive = false
        for _, st in ipairs(combatGodStates) do
            pcall(function() hum:SetStateEnabled(st, true) end)
        end
        for part, col in pairs(combatSavedCollisions) do
            if part and part.Parent then
                pcall(function() part.CanCollide = col end)
            end
        end
        table.clear(combatSavedCollisions)
    end
end

