end

local petThumbnailCache = {}

local function resolvePublicImageUrl(iconAsset, petName, petCategory, eggInstance)
    if petName and petThumbnailCache[petName] then
        return petThumbnailCache[petName]
    end
    if petCategory and petThumbnailCache[petCategory] then
        return petThumbnailCache[petCategory]
    end

    -- 0. Tenta obter o Icon oficial direto do ReplicatedStorage Assets.Directory para QUALQUER pet
    if (not iconAsset or iconAsset == "") and petCategory and Assets and type(Assets.Directory) == "table" then
        local entry = Assets.Directory[petCategory] or (petName and Assets.Directory[petName])
        if entry and entry.Icon then
            iconAsset = tostring(entry.Icon)
        end
    end

    local function doFetch(url)
        local reqFn = (syn and syn.request) or (http and http.request) or http_request or request
        if reqFn then
            local ok, res = pcall(function()
                return reqFn({
                    Url = url,
                    Method = "GET",
                    Headers = { ["User-Agent"] = "Roblox/WinInet" }
                })
            end)
            if ok and res and (res.StatusCode == 200 or res.Status == 200) and res.Body then
                return res.Body
            end
        end
        if game and type(game.HttpGet) == "function" then
            local ok, body = pcall(function() return game:HttpGet(url) end)
            if ok and body and body ~= "" then return body end
        end
        return nil
    end

    local function fetchThumbnailFromAssetId(numericId)
        if not numericId or #numericId < 4 then return nil end
        local endpoints = {
            string.format("https://thumbnails.roproxy.com/v1/assets?assetIds=%s&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false", numericId),
            string.format("https://thumbnails.roblox.com/v1/assets?assetIds=%s&returnPolicy=PlaceHolder&size=420x420&format=Png&isCircular=false", numericId),
            string.format("https://thumbnails.roproxy.com/v1/assets?assetIds=%s&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false", numericId),
            string.format("https://thumbnails.roblox.com/v1/assets?assetIds=%s&returnPolicy=PlaceHolder&size=150x150&format=Png&isCircular=false", numericId),
        }
        for _, url in ipairs(endpoints) do
            local body = doFetch(url)
            if body then
                local decOk, decoded = pcall(function() return HttpService:JSONDecode(body) end)
                if decOk and decoded and decoded.data and decoded.data[1] then
                    local imgUrl = decoded.data[1].imageUrl
                    if imgUrl and type(imgUrl) == "string" and imgUrl:find("rbxcdn%.com") then
                        return imgUrl
                    end
                end
            end
            task.wait(0.1)
        end
        return nil
    end

    -- 1. Se iconAsset já veio com ID numérico
    if iconAsset and tostring(iconAsset) ~= "" then
        local rawStr = tostring(iconAsset)
        local assetId = rawStr:match("%d+")
        if assetId and #assetId >= 4 then
            local img = fetchThumbnailFromAssetId(assetId)
            if img then
                if petName then petThumbnailCache[petName] = img end
                if petCategory then petThumbnailCache[petCategory] = img end
                return img
            end
        end
    end

    -- 2. Tenta extrair TextureId/Decal/MeshPart do modelo físico do ovo no Workspace
    if eggInstance and eggInstance.Parent then
        local foundTextureId = nil
        for _, desc in ipairs(eggInstance:GetDescendants()) do
            if desc:IsA("Decal") and desc.Texture ~= "" then
                foundTextureId = tostring(desc.Texture):match("%d+")
            elseif desc:IsA("MeshPart") and desc.TextureID ~= "" then
                foundTextureId = tostring(desc.TextureID):match("%d+")
            elseif desc:IsA("SpecialMesh") and desc.TextureId ~= "" then
                foundTextureId = tostring(desc.TextureId):match("%d+")
            end
            if foundTextureId and #foundTextureId >= 4 then break end
        end
        if foundTextureId and #foundTextureId >= 4 then
            local img = fetchThumbnailFromAssetId(foundTextureId)
            if img then
                if petName then petThumbnailCache[petName] = img end
                if petCategory then petThumbnailCache[petCategory] = img end
                return img
            end
        end
    end

    -- 3. Procura no ReplicatedStorage por modelo correspondente à categoria 3D do pet
    if petCategory and petCategory ~= "" and petCategory ~= "Unknown" then
        local searchRoots = {
            ReplicatedStorage:FindFirstChild("Assets"),
            ReplicatedStorage:FindFirstChild("Data") and ReplicatedStorage.Data:FindFirstChild("Assets"),
            ReplicatedStorage:FindFirstChild("Shared") and ReplicatedStorage.Shared:FindFirstChild("Assets")
        }
        for _, root in ipairs(searchRoots) do
            if root then
                local model = root:FindFirstChild(petCategory, true)
                if model then
                    local textureId = nil
                    for _, desc in ipairs(model:GetDescendants()) do
                        if desc:IsA("Decal") and desc.Texture ~= "" then
                            textureId = tostring(desc.Texture):match("%d+")
                        elseif desc:IsA("MeshPart") and desc.TextureID ~= "" then
                            textureId = tostring(desc.TextureID):match("%d+")
                        elseif desc:IsA("SpecialMesh") and desc.TextureId ~= "" then
                            textureId = tostring(desc.TextureId):match("%d+")
                        end
                        if textureId and #textureId >= 4 then break end
                    end
                    if textureId and #textureId >= 4 then
                        local img = fetchThumbnailFromAssetId(textureId)
                        if img then
                            if petName then petThumbnailCache[petName] = img end
                            petThumbnailCache[petCategory] = img
                            return img
                        end
                    end
                end
            end
        end
    end

    return nil
end

