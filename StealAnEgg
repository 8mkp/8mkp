-- SISTEMA DE VALIDACAO E FILTRAGEM DE PROMPT E OVOS (CHILLI HUB fn26, fn28, fn29)
-- ====================================================================
-- fn28: Distancia 2D XZ
local function chilliDist2D(p1, p2)
    return (Vector3.new(p1.X, 0, p1.Z) - Vector3.new(p2.X, 0, p2.Z)).Magnitude
end

-- fn29: Pivot Position
local function chilliGetPivot(model)
    local ok, res = pcall(function() return model:GetPivot().Position end)
    return ok and res or nil
end

-- fn26: Valida se o SmartPromptPart pertence estritamente ao ovo correto e a nenhum outro
local function chilliValidatePromptPart(promptPart, uid, eggPos)
    local distRef = chilliDist2D(promptPart.Position, eggPos)
    local slots = Workspace:FindFirstChild("AreaEggSlotsClient")
    if slots then
        for _, child in ipairs(slots:GetChildren()) do
            if child:IsA("Model") and child.Name ~= uid then
                local p = chilliGetPivot(child)
                if p and chilliDist2D(p, promptPart.Position) + 1.5 < distRef then
                    return false
                end
            end
        end
    end
    for _, child in ipairs(Workspace:GetChildren()) do
        if child:IsA("Model") and child.Name ~= uid and #child.Name == 32 and child:FindFirstChild("Hitbox") then
            local p = chilliGetPivot(child)
            if p and chilliDist2D(p, promptPart.Position) + 1.5 < distRef then
                return false
            end
        end
    end
    return true
end

-- ====================================================================
-- SISTEMA DE INSTANT PROXIMITY PROMPT (ZERO DELAY / AUTO-HOLD INSTANTANEO)
-- ====================================================================
local function isPromptOfSelectedTarget(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") then return false end

    -- SO aciona se houver um ovo alvo selecionado na lista ou sendo roubado
    local targetUidToCheck = activeStealUid or selectedUid
    if not targetUidToCheck or targetUidToCheck == "" then
        return false
    end

    -- 1. Se pertence diretamente ao modelo ativo do alvo
    if activeStealModel and prompt:IsDescendantOf(activeStealModel) then
        return true
    end

    -- 2. Se a hierarquia do prompt pertence a um modelo de ovo
    local current = prompt.Parent
    while current and current ~= Workspace do
        if current:IsA("Model") or current:IsA("Folder") then
            local u = current:GetAttribute("UID") or current:GetAttribute("EggUid") or current.Name
            if u == targetUidToCheck then
                return true
            elseif #current.Name == 32 and current.Name ~= targetUidToCheck then
                -- Pertence COM CERTEZA a outro ovo! Rejeita imediatamente!
                return false
            end
        end
        current = current.Parent
    end

    -- 3. Se e um SmartPromptPart no Workspace (mecanismo oficial do jogo)
    local part = prompt.Parent
    if part and part:IsA("BasePart") then
        local refPos = activeStealPos
        if not refPos then
            local targetModel = Workspace:FindFirstChild(targetUidToCheck) 
                or (Workspace:FindFirstChild("AreaEggSlotsClient") and Workspace.AreaEggSlotsClient:FindFirstChild(targetUidToCheck))
            if targetModel then
                refPos = chilliGetPivot(targetModel)
            end
        end

        if refPos then
            local dist = chilliDist2D(part.Position, refPos)
            if dist <= 14 then
                -- Valida via fn26 do Chilli Hub se outro ovo nao esta mais perto deste prompt
                if chilliValidatePromptPart(part, targetUidToCheck, refPos) then
                    return true
                end
            end
        end
    end

    return false
end

local function triggerPromptImmediately(prompt)
    -- CHECAGEM ESTRITA: Só aciona o prompt se for EXATAMENTE o ovo do alvo selecionado!
    if not isPromptOfSelectedTarget(prompt) then return end
    
    pcall(function()
        prompt.HoldDuration = 0
        prompt.RequiresLineOfSight = false
        prompt.MaxActivationDistance = math.max(prompt.MaxActivationDistance, 40)
