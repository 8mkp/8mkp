-- fn20: Calculo de velocidade e compensacao de gravidade fluido (Chilli fn20 com tolerância dinâmica)
local function chilliStepVelocity(root, targetPos, speed, dt, tracking)
    local diff = targetPos - root.Position
    local mag = diff.Magnitude
    local dtClamp = math.max(dt, 0.00416666)
    local stepDist = speed * dtClamp

    -- Se esta perto o suficiente de completar o passo (ou < 3.5 studs), conclui com snap suave
    if mag <= math.max(stepDist, 3.5) then
        pcall(function()
            root.CFrame = CFrame.new(targetPos) * root.CFrame.Rotation
            root.AssemblyLinearVelocity = Vector3.zero
            root.AssemblyAngularVelocity = Vector3.zero
        end)
        return true
    end

    local dir = diff.Unit * math.min(speed, mag / dtClamp)
    local vel = dir + Vector3.new(0, Workspace.Gravity * dtClamp * 0.5, 0)

    -- Sistema Anti-Stuck do Chilli Hub: se ficar 0.25s sem avancar, da nudge por CFrame para nao travar em nada
    if not tracking.mark then
        tracking.mark = mag
        tracking.clock = 0
    end
    tracking.clock = tracking.clock + dt
    if tracking.clock >= 0.25 then
        if tracking.mark - mag < speed * 0.05 then
            pcall(function()
                root.CFrame = root.CFrame + diff.Unit * math.min(mag, speed * dtClamp * 2)
            end)
        end
        tracking.mark = mag
        tracking.clock = 0
    end

    pcall(function()
        root.AssemblyLinearVelocity = vel
        root.AssemblyAngularVelocity = Vector3.zero
    end)
    return false
end

-- fn33: Voo fisico nativo com no-clip dinamico e suporte a cancelamento (Chilli fn33)
local function chilliFlyNative(targetPos, cancelCheck, isCarry, speed)
    local root = o.Character and o.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local char = o.Character
    local flySpeed = speed or 180
    local tracking = {}
    local reached = nil
    local elapsed = 0

    local connPreSim = nil

    -- Desativa colisao das partes do corpo durante o voo para nao esbarrar em paredes invisiveis
    pcall(function()
        for _, p in ipairs(char:GetDescendants()) do
            if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                p.CanCollide = false
            end
        end
    end)

    local function cleanupFly()
        if connPreSim then connPreSim:Disconnect(); connPreSim = nil end
        local r = o.Character and o.Character:FindFirstChild("HumanoidRootPart")
        if r then
            pcall(function()
                r.AssemblyLinearVelocity = Vector3.zero
                r.AssemblyAngularVelocity = Vector3.zero
            end)
        end
        pcall(function()
            local ch = o.Character
            if ch then
                for _, p in ipairs(ch:GetDescendants()) do
                    if p:IsA("BasePart") and p.Name ~= "HumanoidRootPart" then
                        p.CanCollide = true
                    end
                end
            end
        end)
    end

    connPreSim = RunService.PreSimulation:Connect(function(dt)
        if reached ~= nil then return end
        elapsed = elapsed + dt
        if cancelCheck and cancelCheck() then
            reached = false
            return
        end
        if isCarry and not (isHoldingTargetEgg() or (SafeCarry and SafeCarry.IsCarrying)) then
            reached = false
            return
        end
        local curRoot = o.Character and o.Character:FindFirstChild("HumanoidRootPart")
        local curHum = o.Character and o.Character:FindFirstChildOfClass("Humanoid")
        if not curRoot or elapsed >= 30 or o.Character ~= char then
            reached = false
            return
        end
        if curHum and curHum.PlatformStand then
            curHum.PlatformStand = false
        end

        if chilliStepVelocity(curRoot, targetPos, flySpeed, dt, tracking) then
            reached = true
        end
    end)

    while reached == nil do
        RunService.Heartbeat:Wait()
    end

    cleanupFly()
    return reached == true
end

-- Chilli fn49 / FlyTo: Voo alto no ceu com transicao continua e sem interrupcoes (Chilli Hub)
local function chilliFlyHigh(targetPos, cancelCheck, isCarry, speed)
    local root = o.Character and o.Character:FindFirstChild("HumanoidRootPart")
    if not root then return false end

    local flySpeed = speed or 180
    local startPos = root.Position
    local arrivalPos = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos
    arrivalPos = Vector3.new(arrivalPos.X, arrivalPos.Y + 3.0, arrivalPos.Z)

    local curDist = chilliDist2D(startPos, arrivalPos)
    if curDist < 40 then
        return chilliFlyNative(arrivalPos, cancelCheck, isCarry, flySpeed)
    end

    local cruiseY = math.max(startPos.Y, arrivalPos.Y) + 70

    -- Etapa 1: Subida vertical para a altitude de cruzeiro
    local wp1 = Vector3.new(startPos.X, cruiseY, startPos.Z)
    local ok1 = chilliFlyNative(wp1, cancelCheck, isCarry, flySpeed)
    if not ok1 and cancelCheck and cancelCheck() then return false end

    -- Etapa 2: Cruzeiro no ceu em linha reta ate acima do ninho
    local wp2 = Vector3.new(arrivalPos.X, cruiseY, arrivalPos.Z)
    local ok2 = chilliFlyNative(wp2, cancelCheck, isCarry, flySpeed)
    if not ok2 and cancelCheck and cancelCheck() then return false end

    -- Etapa 3: Descida suave e precisa direto em cima do ninho
    local ok3 = chilliFlyNative(arrivalPos, cancelCheck, isCarry, flySpeed)
    return ok3
end

-- Chilli fn44 & fn30: Pegar o ovo com ProximityPrompt e Fallback para CarryFieldEgg (100% Chilli)
local function chilliGrabEggExact(eggUid, eggPos, cancelCheck)
    local deadline = 0.6
    local elapsed = 0
    local huge = math.huge

    while elapsed < deadline do
        if cancelCheck and cancelCheck() then return false end
        if SafeCarry and SafeCarry.IsCarrying and SafeCarry.WrongEgg(eggUid) then end
        if isHoldingTargetEgg(eggUid) then
            return true
        end
        if huge >= 0.1 then
            local prompt = chilliFindPrompt(eggUid, eggPos)
            if prompt then
                pcall(function() prompt.HoldDuration = 0 end)
                if typeof(fireproximityprompt) == "function" then
                    pcall(fireproximityprompt, prompt)
                end
            else
                chilliCallCarryEgg(eggUid)
            end
            huge = 0
        end
        local dt = RunService.Heartbeat:Wait()
        elapsed = elapsed + dt
        huge = huge + dt
    end

    if SafeCarry and SafeCarry.IsCarrying and SafeCarry.WrongEgg(eggUid) then end
    if isHoldingTargetEgg(eggUid) then
        return true
    end

    -- fn30 fallback: 1.5s com polling de 0.06s (Chilli fn30)
    local n11 = 0
    huge = math.huge
    local misses = 0
    while n11 < 1.5 do
        if cancelCheck and cancelCheck() then return false end
        if SafeCarry and SafeCarry.IsCarrying and SafeCarry.WrongEgg(eggUid) then end
        if isHoldingTargetEgg(eggUid) then
            return true
        end
        if huge >= 0.06 then
            local prompt = chilliFindPrompt(eggUid, eggPos)
            if prompt then
                pcall(function() prompt.HoldDuration = 0 end)
                misses = 0
                if typeof(fireproximityprompt) == "function" then
                    pcall(fireproximityprompt, prompt)
                end
            else
                misses = misses + 1
                if misses >= 4 then return false end
                chilliCallCarryEgg(eggUid)
            end
            huge = 0
        end
        local dt = RunService.Heartbeat:Wait()
        n11 = n11 + dt
        huge = huge + dt
    end

    if SafeCarry and SafeCarry.IsCarrying and SafeCarry.WrongEgg(eggUid) then end
    return isHoldingTargetEgg(eggUid)
end

