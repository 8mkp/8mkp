local function redirectControls(humanoid)
    pcall(function()
        local playerScripts = Players.LocalPlayer:FindFirstChild("PlayerScripts")
        local playerModule = playerScripts and playerScripts:FindFirstChild("PlayerModule")
        if playerModule then
            local controls = require(playerModule):GetControls()
            if type(controls) == "table" then
                controls.humanoid = humanoid
            end
        end
    end)
end

local function kickAnimate(character)
    local animate = character and character:FindFirstChild("Animate")
    if animate and animate:IsA("LocalScript") then
        task.spawn(function()
            animate.Enabled = false
            task.wait()
            animate.Enabled = true
        end)
    end
end

local function cleanupSwapLinks()
    for _, link in ipairs(swapState.Links) do
        pcall(function() link:Disconnect() end)
    end
    table.clear(swapState.Links)
end

function Shield.UndoSwap()
    cleanupSwapLinks()
    local character = Players.LocalPlayer.Character
    local original = swapState.Original
    local clone = swapState.Clone
    swapState.Original = nil
    swapState.Clone = nil
    if original and clone and character and original.Parent == nil and clone.Parent == character then
        original.Parent = character
        Workspace.CurrentCamera.CameraSubject = original
        redirectControls(original)
        pcall(function() clone:Destroy() end)
        kickAnimate(character)
    end
end

-- 1. HUMANOID SWAP (fn14) - Desincroniza ouvintes de física do jogo
local function executeHumanoidSwap()
    local character = Players.LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then return end
    if swapState.Clone and swapState.Clone.Parent == character then return end

    local clone = humanoid:Clone()
    humanoid.Parent = nil
    clone.Parent = character
    Workspace.CurrentCamera.CameraSubject = clone
    redirectControls(clone)
    kickAnimate(character)

    swapState.Original = humanoid
    swapState.Clone = clone

    table.insert(swapState.Links, humanoid:GetPropertyChangedSignal("WalkSpeed"):Connect(function()
        if clone.Parent ~= nil then
            clone.WalkSpeed = humanoid.WalkSpeed
        end
    end))

    local animator = humanoid:FindFirstChildOfClass("Animator")
    local animator2 = clone:FindFirstChildOfClass("Animator")
    if animator and animator2 then
        table.insert(swapState.Links, animator.AnimationPlayed:Connect(function(arg)
            local animation = arg.Animation
            if not animation or clone.Parent == nil then return end
            local ok, track = pcall(function() return animator2:LoadAnimation(animation) end)
            if not ok or not track then return end
            pcall(function()
                track.Priority = arg.Priority
                track.Looped = arg.Looped
                track:Play(0.05, math.max(arg.WeightTarget, 0.01), arg.Speed)
            end)
            local stopConn = nil
            stopConn = arg.Stopped:Connect(function()
                stopConn:Disconnect()
                pcall(function() track:Stop(0.1) end)
            end)
        end))
    end

    table.insert(swapState.Links, clone.Died:Connect(function()
        Shield.UndoSwap()
        humanoid.Health = 0
    end))
end

-- 2. DISABLE MONITOR (fn15) - Desativa conexões de anti-cheat client-side UGI
local function disableUGIMonitors()
    if type(getconnections) ~= "function" then return end
    for _, event in ipairs({RunService.Heartbeat, RunService.PreSimulation, RunService.PostSimulation}) do
        local ok, conns = pcall(getconnections, event)
        if ok and type(conns) == "table" then
            for _, conn in ipairs(conns) do
                local ok2, fn = pcall(function() return conn.Function end)
                if ok2 and type(fn) == "function" then
                    local ok3, src = pcall(debug.info, fn, "s")
                    if ok3 and string.find(tostring(src), "UGI", 1, true) then
                        local ok4, enabled = pcall(function() return conn.Enabled end)
                        if not ok4 or enabled ~= false then
                            if pcall(function() conn:Disable() end) then
                                table.insert(disabledUGIConnections, conn)
                            end
                        end
                    end
                end
            end
        end
    end
end

local function restoreUGIMonitors()
    if shieldConnection then
        shieldConnection:Disconnect()
        shieldConnection = nil
    end
    for _, conn in ipairs(disabledUGIConnections) do
        pcall(function() conn:Enable() end)
    end
    table.clear(disabledUGIConnections)
end

function Shield.Activate(tag)
    shieldTags[tag] = true
    pcall(disableUGIMonitors)

    if not shieldConnection then
        shieldHeartbeatTimer = 0
        shieldConnection = RunService.Heartbeat:Connect(function(dt)
            shieldHeartbeatTimer = shieldHeartbeatTimer + dt
            if shieldHeartbeatTimer >= 3 then
                shieldHeartbeatTimer = 0
                pcall(disableUGIMonitors)
            end
        end)
    end
end

    function Shield.Deactivate(tag)
        shieldTags[tag] = nil
        if next(shieldTags) == nil then
            restoreUGIMonitors()
        end
    end
end

