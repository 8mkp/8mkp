    if not tread and plot then tread = plot:FindFirstChild("TreadmillBottom", true) end
    if not tread then return end

    local targetPos = tread.Position + Vector3.new(0, 2, 0)
    if (hrp.Position - targetPos).Magnitude > 8 then
        hrp.CFrame = CFrame.new(targetPos)
        hrp.AssemblyLinearVelocity = Vector3.zero
        task.wait(0.1)
    end

    pcall(function()
        if typeof(firetouchinterest) == "function" then
            firetouchinterest(hrp, tread, 0)
            task.wait(0.02)
            firetouchinterest(hrp, tread, 1)
        end
        for _, desc in ipairs(tread:GetDescendants()) do
            if desc:IsA("ProximityPrompt") and desc.Enabled then
                if typeof(fireproximityprompt) == "function" then fireproximityprompt(desc) end
            end
        end
    end)

    if l then pcall(function() l:InvokeServer() end) end
end

