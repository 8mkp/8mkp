local function sendHttp(data)
    local fn = (syn and syn.request) or (http and http.request) or http_request or request
    if fn then
        local success, result = pcall(function()
            return fn({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = { ["Content-Type"] = "application/json" },
                Body = HttpService:JSONEncode(data)
            })
        end)
        return success
    end
    return false
end

local function resolvePublicImageUrl(iconAsset)
    if not iconAsset or type(iconAsset) ~= "string" or iconAsset == "" then return nil end
    local assetId = iconAsset:match("%d+")
    if not assetId then return nil end

    local reqFn = (syn and syn.request) or (http and http.request) or http_request or request
    if reqFn then
        local ok, res = pcall(function()
            return reqFn({
                Url = string.format("https://thumbnails.roblox.com/v1/assets?assetIds=%s&size=420x420&format=Png&isCircular=false", assetId),
                Method = "GET"
            })
        end)
        if ok and res and res.Body then
            local decOk, decoded = pcall(function() return HttpService:JSONDecode(res.Body) end)
            if decOk and decoded and decoded.data and decoded.data[1] and decoded.data[1].imageUrl then
                return decoded.data[1].imageUrl
            end
        end
    end

    return string.format("https://www.roblox.com/asset-thumbnail/image?assetId=%s&width=420&height=420&format=png", assetId)
end

