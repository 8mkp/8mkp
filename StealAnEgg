local function resolveRemote(name, fallback)
    local netPkg = (ReplicatedStorage:FindFirstChild("Packages") and ReplicatedStorage.Packages:FindFirstChild("Networking"))
        or ReplicatedStorage:FindFirstChild("Network") or ReplicatedStorage
    local direct = netPkg:FindFirstChild(name) or ReplicatedStorage:FindFirstChild(name)
    if direct then return direct end
    local deep = netPkg:FindFirstChild(name, true) or ReplicatedStorage:FindFirstChild(name, true)
    if deep then return deep end
    if fallback then
        local f = netPkg:FindFirstChild(fallback) or ReplicatedStorage:FindFirstChild(fallback)
        if f then return f end
        local fDeep = netPkg:FindFirstChild(fallback, true) or ReplicatedStorage:FindFirstChild(fallback, true)
        if fDeep then return fDeep end
    end
    return nil
end

