-- Extrai Nome Oficial, Raridade, Categoria 3D e Taxa Base do Bicho
local function getPetInfoFromEgg(eggRecord)
    if not eggRecord then return "Unknown", "Common", "Unknown", 0, "" end
    
    local categoryKey = type(eggRecord) == "string" and eggRecord 
        or (eggRecord.AssetCategory or eggRecord.Category or eggRecord.Name)
        
    local assetInfo = Assets and Assets.Directory and Assets.Directory[categoryKey]
    local cfg = getPetConfig(categoryKey)
    
    -- 1. Categoria oficial 3D do pet (para o AssetViewport)
    local petCategory = (assetInfo and assetInfo.Category) or categoryKey or "Unknown"
    
    -- 2. Nome oficial do pet (inglês/jogo)
    local petName = (assetInfo and (assetInfo.DisplayName or assetInfo.Name or assetInfo._id))
        or (cfg and (cfg.DisplayName or cfg._id or cfg.Name))
