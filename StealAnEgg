local function updateRanking()
    if isDestroyed then return end

    local data = nil
    if EggState then
        local s, res = pcall(function() return EggState:ReadFieldEggs() end)
        if s and res and res.Records then
            data = res
        else
            local s2, res2 = pcall(function() return EggState.ReadFieldEggs() end)
            if s2 and res2 and res2.Records then data = res2 end
        end
    end

    if not (data and data.Records) then return end

    local ranked = {}
    local processed = {}
    local newHighTierEggs = {}

    for slotKey, rec in pairs(data.Records) do
        local isCarried = false
        if rec.State ~= nil then
            local stateVal = rec.State
            local stateStr = tostring(stateVal):lower()
            if stateStr:find("carr") or stateStr:find("held") or stateStr:find("pick") or stateVal == 2 then 
                isCarried = true 
            end
            if stateStr ~= "slot" and stateStr ~= "dropped" and stateStr ~= "guardcarried" and stateVal ~= 1 then
                isCarried = true
            end
        end
        if rec.Carrier and rec.Carrier ~= false and rec.Carrier ~= 0 and rec.Carrier ~= "" then isCarried = true end
        if rec.CarrierUserId and type(rec.CarrierUserId) == "number" and rec.CarrierUserId > 0 then isCarried = true end
        if rec.IsCarried == true or rec.Removed == true or rec.Active == false then isCarried = true end

        local uid = rec.Uid or slotKey

        -- Checa disponibilidade no DICE_ENGINE se disponivel
        if not isCarried and DICE_ENGINE and typeof(DICE_ENGINE.v63) == "function" then
            local avail, status = DICE_ENGINE.v63(uid)
            if not avail and status == "CarriedByOther" then
                isCarried = true
            end
        end

        local uid = rec.Uid or slotKey

        if not isCarried and not processed[uid] then
            processed[uid] = true

            local englishName, rarityName, petCategory, baseRate, iconAsset = getPetInfoFromEgg(rec)

            local scale = tonumber(rec.AssetScale) or 1
            local mutation = rec.BaseMutation or "Normal"
            local mutBonus = 1

            if rec.Mutations and #rec.Mutations > 0 and Mutations and type(Mutations.EarningsFor) == "function" then
                local okMut, resMut = pcall(function()
                    return Mutations.EarningsFor(rec.Mutations)
                end)
                if okMut and resMut then
                    mutBonus = tonumber(resMut) or 1
                end
            elseif rec.BaseMutation and mutationMultipliers[rec.BaseMutation] then
                mutBonus = mutationMultipliers[rec.BaseMutation] or 1.0
            end

            local realIncome = math.round(baseRate * getScaleMultiplier(scale) * mutBonus)
            local priority = rarityPriority[rarityName] or (mutation == "Eternal" and 110) or 0

            local targetCF = rec.BoundsCFrame or rec.BottomCFrame or rec.CFrame or CFrame.new()

            local eggEntry = {
                uid = uid,
                slotKey = slotKey,
                instance = rec.Instance or rec.Model or rec.EggInstance,
                CFrame = targetCF,
                BoundsCFrame = rec.BoundsCFrame,
                name = englishName,
                category = petCategory,
                rarity = rarityName,
                priority = priority,
                mutation = mutation,
                scale = scale,
                income = realIncome,
                formattedIncome = formatIncome(realIncome),
                icon = iconAsset
            }

            -- VALIDAÇÃO FÍSICA NO MAPA: Garante que o ovo está no campo (X >= 530)
            local inst = resolveEggInstance(eggEntry)
            local pos = targetCF and targetCF.Position
            local inField = pos and (pos.X >= 530)
            if inField then
                -- Se o modelo físico foi localizado, confirma que está válido no Workspace
                -- Se for nil, o ovo é válido via EggState (modelos a mais de 1000 studs em Volcano/Cyber não transmitem com StreamingEnabled até você chegar perto)
                if inst then
                    if inst.Parent and inst:IsDescendantOf(Workspace) then
                        eggEntry.instance = inst
                        table.insert(ranked, eggEntry)
                    end
                else
                    table.insert(ranked, eggEntry)
                end
            end

            -- ========================================================
            -- FILTRO ESTRITO:
            -- 1. Divino ou Eterno: SEMPRE NOTIFICA
            -- 2. Secret: APENAS SE >= 600M
            -- ========================================================
            local rLower = rarityName:lower()
            local mLower = mutation:lower()
            local nLower = englishName:lower()

            local isDivine = rLower:find("divin") or nLower:find("divino")
            local isEternal = rLower:find("etern") or mLower:find("etern") or nLower:find("eterno") or nLower:find("bico eterno")
            local isSecret = rLower:find("secret") or nLower:find("secret")

            local shouldNotify = false
            local embedColor = 11482111

            if isEternal then
                shouldNotify = true
                embedColor = 53011
            elseif isDivine then
                shouldNotify = true
                embedColor = 16766720
            elseif isSecret and realIncome >= 600e6 then
                shouldNotify = true
                embedColor = 13382655
            end

            if shouldNotify and not notifiedEggsCache[uid] then
                notifiedEggsCache[uid] = true
                table.insert(newHighTierEggs, eggEntry)

                task.spawn(function()
                    -- Usa o sistema completo de resolução de ícones (Asset, Modelo 3D, Workspace e Curated)
                    local iconToUse = (eggEntry.icon and eggEntry.icon ~= "") and eggEntry.icon or iconAsset
                    local publicImage = resolvePublicImageUrl(iconToUse, englishName, petCategory, eggEntry.instance or inst)
                    if publicImage then
                        print("[Sappire Hub] Webhook pet icon OK (" .. tostring(englishName) .. "): " .. tostring(publicImage))
                    else
                        print("[Sappire Hub] Webhook pet icon (" .. tostring(englishName) .. ") nao encontrado. Enviando embed limpo.")
                    end

                    -- Resolve local da área baseado no slotKey, rec ou coordenada X
                    local locName = "Field"
                    if rec.Area and rec.Area ~= "" then
                        locName = tostring(rec.Area)
                    elseif rec.Zone and rec.Zone ~= "" then
                        locName = tostring(rec.Zone)
                    elseif type(slotKey) == "string" and slotKey:find("_") then
                        locName = slotKey:match("^([%a%s]+)_") or "Field"
                    else
                        local posX = targetCF.Position.X
                        if posX >= 5000 then locName = "Cyber"
                        elseif posX >= 4100 then locName = "Volcano"
                        elseif posX >= 3200 then locName = "Cherry Blossom"
                        elseif posX >= 2200 then locName = "Prehistoric"
                        elseif posX >= 1300 then locName = "Desert"
                        else locName = "Farm"
                        end
                    end

                    -- Emoji de localização temático
                    local locEmoji = "📍"
                    if locName:find("Prehistoric") then locEmoji = "🦖"
                    elseif locName:find("Cherry") then locEmoji = "🌸"
                    elseif locName:find("Volcano") then locEmoji = "🌋"
                    elseif locName:find("Cyber") then locEmoji = "🤖"
                    elseif locName:find("Desert") then locEmoji = "🌵"
                    elseif locName:find("Farm") then locEmoji = "🌾"
                    end

                    -- Título e emoji principal baseado na raridade
                    local rarityEmoji = "🥚"
                    local rarityTitle = rarityName .. " Egg"
                    if isEternal then
                        rarityEmoji = "🟣"
                        rarityTitle = "Eternal Egg"
                    elseif isDivine then
                        rarityEmoji = "⚡"
                        rarityTitle = "Divine Egg"
                    elseif isSecret then
                        rarityEmoji = "💎"
                        rarityTitle = "Secret Egg"
                    end

                    local timeString = os.date("%H:%M")
                    local titleStr = string.format("%s %s Spawned!! - %s", rarityEmoji, rarityTitle, timeString)

                    -- Formatação de dinheiro (~$Xm/s ou ~$Xb/s)
                    local moneyStr = string.format("~$%s/s", formatIncome(realIncome))

                    -- Formatação de tamanho do ovo (ex: 1.00x)
