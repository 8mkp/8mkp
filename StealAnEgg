-- Heartbeat: Varredura de alvos, ataque do Chilli Hub e manutenção de voo (steal_a_egg_v2 linhas 7465-7485)
local combatScanInterval = 0.05
local combatNextScanTime = 0
local combatAuraVictim = nil

local function combatGetNearestHittable(fromPos, maxDist)
    local best = nil
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= Players.LocalPlayer and isPlayerHittable(pl) and not isTargetRagdolled(pl) then
            local pHrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
            if pHrp then
                local d = (pHrp.Position - fromPos).Magnitude
                if d < maxDist then
                    maxDist = d
                    best = pl
                end
            end
        end
    end
    return best, maxDist
end

local function combatHeartbeatTick()
    local isCombatActive = autoHitNearestEnabled or autoHitEggHoldersEnabled
    local isAuraActive = hitAuraEnabled

    if not isAuraActive then
        combatAuraVictim = nil
    end

    if not isCombatActive and not isAuraActive then
        if combatState.Target or combatState.Moving then
            combatState.Target = nil
            stopCombatFlight()
        end
        return
    end

    local char = o.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum or hum.Health <= 0 then
        combatState.Target = nil
        stopCombatFlight()
        return
    end

    combatGodTick()

    local eventMult = (Workspace:GetAttribute("DragonEggEventActive") == true) and 2.5 or 1
    local batRange = (15 + 2) * eventMult

    -- Modo 1: Hit Aura exclusivo (sem perseguição/voo)
    if not isCombatActive and isAuraActive then
        local auraReach = batRange + 6
        local victim, dist = combatGetNearestHittable(hrp.Position, auraReach + 24)
        if not victim or dist > auraReach then
            combatAuraVictim = nil
            if victim then
                local b = findBestBatTool()
                if b then equipBat(b) end
            end
        else
            combatAuraVictim = victim
            combatTryHit(victim, combatPlan(victim, hrp))
        end
        return
    end

    -- Modo 2: Auto Hit Nearest Player ou Egg Holders (Perseguição + Ataque)
    local myPos = hrp.Position
    local bestPlayer = nil
    local bestDist = math.huge

    for _, pl in ipairs(Players:GetPlayers()) do
        if pl ~= Players.LocalPlayer and isPlayerHittable(pl) and not isTargetRagdolled(pl) then
            local isValid = false
            if autoHitEggHoldersEnabled then
                if isPlayerHoldingEgg(pl) then isValid = true end
            elseif autoHitNearestEnabled then
                isValid = true
            end

            if isValid then
                local pHrp = pl.Character and pl.Character:FindFirstChild("HumanoidRootPart")
                if pHrp then
                    local d = (pHrp.Position - myPos).Magnitude
                    if d < bestDist then
                        bestDist = d
                        bestPlayer = pl
                    end
                end
            end
        end
    end

    combatState.Target = bestPlayer
    if not bestPlayer then
        stopCombatFlight()
        if isAuraActive then
            local auraReach = batRange + 6
            local victim, dist = combatGetNearestHittable(hrp.Position, auraReach + 24)
            if victim and dist <= auraReach then
                combatAuraVictim = victim
                combatTryHit(victim, combatPlan(victim, hrp))
            else
                combatAuraVictim = nil
            end
        end
        return
    end

    local plan = combatPlan(bestPlayer, hrp)
    if plan and not isAutoStealActive then
        startCombatFlight()
        combatState.Plan = plan
    else
        stopCombatFlight()
    end
    combatTryHit(bestPlayer, plan)
end

