local function restoreCharacterMovement()
    local char = o.Character
    if not char then return end

    -- Remove soldas rigidas injetadas pelo anti-ragdoll que deixam bracos e pernas duros
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("WeldConstraint") and desc.Name:find("RigidJointWeld_") then
            pcall(function() desc:Destroy() end)
        end
        if desc:IsA("Motor6D") then
            desc.Enabled = true
        end
        if desc:IsA("BasePart") then
            desc.CanTouch = true
            if desc.Name ~= "HumanoidRootPart" then
                desc.CanCollide = true
            end
        end
    end

    local hum = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if hum then
        hum.AutoRotate    = true
        hum.PlatformStand = false
        hum.Sit           = false

        -- Força WalkSpeed e JumpPower para os valores padrão do jogo (não deixa travar em 0)
        -- Se o WalkSpeed atual for menor que 16, reseta pro default; se for maior, preserva
        if hum.WalkSpeed < 16 then
            hum.WalkSpeed = 16
        end
        if hum.JumpPower < 50 then
            hum.JumpPower = 50
        end

        -- Reabilita todos os estados do humanoid
        hum:SetStateEnabled(Enum.HumanoidStateType.Running,  true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Jumping,  true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Freefall, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Climbing, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
        hum:SetStateEnabled(Enum.HumanoidStateType.Seated,   false)
        hum:ChangeState(Enum.HumanoidStateType.Running)
    end

    if hrp then
        hrp.Anchored = false
        hrp.AssemblyLinearVelocity  = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero

        -- Devolve o controle de fisica do HRP pro client (corrige lentidao pos-TP)
        pcall(function()
            hrp:SetNetworkOwner(Players.LocalPlayer)
        end)
    end

    -- Restaura a camera de volta para o jogador em modo Custom
    local cam = Workspace.CurrentCamera
    if cam then
        pcall(function()
            cam.CameraType = Enum.CameraType.Custom
            if hum then
                cam.CameraSubject = hum
            end
        end)
    end
end

